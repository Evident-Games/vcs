<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- O namespace historico permanece enquanto a migracao e concluida. -->
    <AssemblyName>Desktop</AssemblyName>
    <RootNamespace>VCS.Desktop</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Application\Application.csproj" />
    <ProjectReference Include="..\Editions\V5\Application\Application.V5.csproj" />
    <ProjectReference Include="..\Shared\Infrastructure\Infrastructure.csproj" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
</Project>
