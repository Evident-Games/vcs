<UserControl x:Class="VCS.Desktop.Sheet.CharacterEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sheet="clr-namespace:VCS.Desktop.Sheet"
    xmlns:controls="clr-namespace:VCS.Desktop.Controls"
>
    <UserControl.Style>
        <!-- The host pane paints the sheet surface; the sheet sets its text color for that surface. -->
        <Style TargetType="sheet:CharacterEditorView">
            <Setter Property="Foreground" Value="{DynamicResource ThemeOuterText}" />
            <Style.Triggers>
                <Trigger Property="IsPane" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource ThemeCardText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <DataTemplate x:Key="SheetHeader">
        <Border Margin="0,0,0,8" Padding="10,6" Tag="{DynamicResource ThemeCard}"
                BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="14"
                TextElement.Foreground="{DynamicResource ThemeCardText}" MaxWidth="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}, FallbackValue=1100, TargetNullValue=1100}" AutomationProperties.Name="Cabeçalho da ficha">
            <Border.Background><MultiBinding Converter="{StaticResource SurfaceOpacityConverter}"><Binding RelativeSource="{RelativeSource Self}" Path="Tag" /><Binding Path="DataContext.Display.SurfaceOpacity" RelativeSource="{RelativeSource AncestorType=Window}" /></MultiBinding></Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource ThemeAccent}" CornerRadius="2" Margin="0,2,14,2" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding IdentityHeading}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource ThemeAccentText}" />
                    <TextBlock Text="{Binding Name, ValidatesOnNotifyDataErrors=False}" FontFamily="Georgia"
                               FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    <WrapPanel Margin="0,2,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Clan}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Concept}" Foreground="{DynamicResource ThemeInputDescription}" Margin="12,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                        <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource ThemeAccentText}"
                               FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,0,3" />
                    <WrapPanel HorizontalAlignment="Right">
                        <Border Background="{DynamicResource ThemeInput}" BorderBrush="{DynamicResource ThemeBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="7,3" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="GERAÇÃO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeInputDescription}" />
                                <TextBlock Text="{Binding Generation}" FontFamily="Georgia" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource ThemeInput}" BorderBrush="{DynamicResource ThemeBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="7,3" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="POTÊNCIA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeInputDescription}" />
                                <TextBlock Text="{Binding BloodPotency}" FontFamily="Georgia" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource ThemeInput}" BorderBrush="{DynamicResource ThemeBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="7,3">
                            <StackPanel>
                                <TextBlock Text="FOME" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeInputDescription}" />
                                <TextBlock Text="{Binding Hunger}" FontFamily="Georgia" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
        </DataTemplate>
        <DataTemplate x:Key="Continuous">
            <ScrollViewer x:Name="SheetScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Ficha completa">
                <StackPanel Margin="0,0,12,0">
                    <ContentControl Content="{Binding}" Tag="1100" ContentTemplate="{StaticResource SheetHeader}" />
                    <ItemsControl ItemsSource="{Binding VisibleSections}">
                        <ItemsControl.ItemTemplate><DataTemplate><sheet:SheetSectionView /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate x:Key="Tabbed">
            <TabControl MaxWidth="1100" HorizontalAlignment="Stretch" ItemsSource="{Binding VisibleTabs}" SelectedItem="{Binding SelectedTab}"
                        Background="Transparent" BorderThickness="0" AutomationProperties.Name="Secoes da ficha">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate></TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,10,0">
                            <StackPanel>
                                <ContentControl Content="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TabControl}}" Tag="1100" ContentTemplate="{StaticResource SheetHeader}" />
                                <ItemsControl ItemsSource="{Binding Sections}">
                                    <ItemsControl.ItemTemplate><DataTemplate><sheet:SheetSectionView /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </DataTemplate>
        <DataTemplate x:Key="Bento">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Ficha bento rolável">
                <StackPanel Margin="0,0,4,0">
                    <ContentControl Content="{Binding}" Tag="100000" ContentTemplate="{StaticResource SheetHeader}" />
            <ItemsControl ItemsSource="{Binding VisibleSections}" Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=sheet:CharacterEditorView}}" AutomationProperties.Name="Ficha em bento">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><controls:BentoPanel Columns="4" Gap="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="controls:BentoPanel.ColumnSpan" Value="{Binding Option.Span}" />
                        <Setter Property="controls:BentoPanel.RowWeight" Value="{Binding Option.RowWeight}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource ThemeBorder}" Tag="{DynamicResource ThemeCard}" TextElement.Foreground="{DynamicResource ThemeCardText}"
                                BorderThickness="1" CornerRadius="8" Padding="8,6,4,6"
                                AutomationProperties.Name="{Binding Option.DisplayTitle, StringFormat=Bloco {0}}">
                            <Border.Background><MultiBinding Converter="{StaticResource SurfaceOpacityConverter}"><Binding RelativeSource="{RelativeSource Self}" Path="Tag" /><Binding Path="DataContext.Display.SurfaceOpacity" RelativeSource="{RelativeSource AncestorType=Window}" /></MultiBinding></Border.Background>
                            <DockPanel>
                                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1"
                                        Margin="0,0,4,4" Padding="0,0,0,3">
                                    <TextBlock Text="{Binding Option.DisplayTitle}" FontFamily="Georgia" FontSize="13" FontStyle="Italic"
                                               Foreground="{DynamicResource ThemeAccentText}" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              controls:ScrollChaining.IsEnabled="True">
                                    <sheet:SheetSectionView IsCompact="True" Margin="0,0,6,0" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Grid.Row="1">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource Continuous}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Display.UseTabs}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource Tabbed}" />
                            </DataTrigger>
                            <!-- Only a shown sheet switches to bento; sheets kept built but hidden skip the rebuild. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Display.UseBento}" Value="True" />
                                    <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource AncestorType=sheet:CharacterEditorView}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="ContentTemplate" Value="{StaticResource Bento}" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding WindowViewMode}" Value="Continuous"><Setter Property="ContentTemplate" Value="{StaticResource Continuous}" /></DataTrigger>
                            <DataTrigger Binding="{Binding WindowViewMode}" Value="Tabbed"><Setter Property="ContentTemplate" Value="{StaticResource Tabbed}" /></DataTrigger>
                            <DataTrigger Binding="{Binding WindowViewMode}" Value="Bento"><Setter Property="ContentTemplate" Value="{StaticResource Bento}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <TextBlock Text="Nenhuma secao visivel. Ative uma secao em Exibir > Layout da ficha."
                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding NoVisibleSections, Converter={StaticResource BoolVisibility}}" />
        </Grid>
        <ScrollViewer Grid.Row="2" MaxHeight="100" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,8,0,0" />
                        <Style.Triggers>
                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                            <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="{Binding ValidationSummary}" Foreground="{DynamicResource ThemeAccentText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ThemeAccentText}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
