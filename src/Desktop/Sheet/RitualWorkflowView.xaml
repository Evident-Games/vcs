<UserControl x:Class="Game.Desktop.Sheet.RitualWorkflowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Game.Desktop.Controls">
    <Border Background="{DynamicResource ThemeCard}" CornerRadius="8" Padding="12" Margin="0,8">
        <StackPanel>
            <TextBlock Text="Procedimento do ritual selecionado" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding CoreRitualGuidance}" TextWrapping="Wrap" Margin="0,8"/>
            <TextBlock Text="As proteções de objeto, o despertar e o Santuário usam seus controles próprios abaixo. Nos demais rituais, Preparar inicia um registro; pague as checagens e confirme cada gatilho antes de resolver." TextWrapping="Wrap"/>
            <CheckBox Content="Beneficiário é o conjurador (desmarque para objeto, local ou outro alvo)" IsChecked="{Binding CoreRitualTargetsSelf}"/>
            <TextBlock Text="Alvo / objeto / local"/>
            <TextBox Text="{Binding CoreRitualTarget, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Content="Círculo com duração de um ano e um dia" IsChecked="{Binding CoreRitualLongTermCircle}"/>
            <CheckBox Content="Círculo inscrito apontando para dentro ao redor do intruso" IsChecked="{Binding CoreRitualCirclePointsInward}"/>
            <TextBlock Text="Preparo ou efeito salvo" Margin="0,8,0,0"/>
            <ComboBox ItemsSource="{Binding PowerEffects}" SelectedItem="{Binding SelectedPowerEffect}" DisplayMemberPath="Name"/>
            <TextBlock Text="{Binding SelectedPowerEffect.Target}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SelectedPowerEffect.Effect}" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SelectedPowerEffect.Source}" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,8">
                <TextBlock Text="Checagens pagas: "/><TextBlock Text="{Binding SelectedPowerEffect.RitualWorkflow.ChecksPaid}"/>
                <TextBlock Text=" · Etapa: "/><TextBlock Text="{Binding SelectedPowerEffect.RitualWorkflow.Stage}"/>
                <TextBlock Text=" · Doses: "/><TextBlock Text="{Binding SelectedPowerEffect.RitualWorkflow.Charges}"/>
            </WrapPanel>
            <Expander Header="O Chamado de Dagon: exposição e janela" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="Antes de qualquer Checagem, confirme que a vítima foi exposta ao Sangue do conjurador e que a execução ocorre entre uma hora e uma semana depois. A confirmação fica salva no preparo e vale para suas repetições. Fonte: Livro base, p. 278." TextWrapping="Wrap"/>
                <CheckBox Content="Vítima foi exposta ao Sangue do conjurador" IsChecked="{Binding RitualDagonBloodExposureConfirmed}"/>
                <CheckBox Content="Ao menos uma hora passou desde a exposição" IsChecked="{Binding RitualDagonOneHourElapsedConfirmed}"/>
                <CheckBox Content="Ainda não passou uma semana desde a exposição" IsChecked="{Binding RitualDagonWithinWeekConfirmed}"/>
                <Button Content="Registrar exposição e janela confirmadas" Command="{Binding ConfirmDagonPrerequisiteCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <Button Content="Pagar próxima Checagem de Sangue" Command="{Binding PayRitualWorkflowCheckCommand}" HorizontalAlignment="Left"/>
            <TextBlock Text="Data na crônica (preparo / duração / encerramento)"/>
            <TextBox Text="{Binding PowerGameDate, StringFormat=dd/MM/yyyy, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
            <Button Content="Pedra de Sangue: registrar uma hora nesta noite confirmada" Command="{Binding RecordBloodstonePreparationNightCommand}" HorizontalAlignment="Left"/>
            <Expander Header="Pedra de Sangue: encerramento do vínculo" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="Selecione a pedra ativa, informe acima a data atual da crônica e confirme a condição com a mesa. O vínculo termina após uma semana ou quando a pedra é destruída. Fonte: Livro base, p. 276." TextWrapping="Wrap"/>
                <CheckBox Content="Narrador autorizou encerramento excepcional antes do prazo ou sem data de início" IsChecked="{Binding RitualEndingExceptionApproved}"/>
                <TextBox Text="{Binding RitualEndingExceptionReason, UpdateSourceTrigger=PropertyChanged}" ToolTip="Justificativa obrigatória da decisão excepcional" TextWrapping="Wrap"/>
                <Button Content="Confirmar que uma semana terminou" Command="{Binding EndBloodstoneAfterWeekCommand}" HorizontalAlignment="Left"/>
                <Button Content="Confirmar que a pedra foi destruída" Command="{Binding EndBloodstoneDestroyedCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <WrapPanel>
                <StackPanel Margin="0,8,16,8"><TextBlock Text="Sucessos da oposição (Verdade / Dagon / passageiro)"/><controls:NumericField Value="{Binding CoreRitualOpponentSuccesses}" Minimum="0" Maximum="100"/></StackPanel>
                <StackPanel Margin="0,8,16,8"><TextBlock Text="Raio da área (metros)"/><controls:NumericField Value="{Binding CoreRitualAreaRadius}" Minimum="0" Maximum="100"/></StackPanel>
                <StackPanel Margin="0,8,0,8"><TextBlock Text="Pedras de Sangue já ativas"/><controls:NumericField Value="{Binding CoreRitualActiveBloodstones}" Minimum="0" Maximum="100"/></StackPanel>
            </WrapPanel>
            <CheckBox Content="Alvo é vampiro (obrigatório em Caminho do Sangue; define o dano de Dagon)" IsChecked="{Binding CoreRitualVampireTarget}"/>
            <CheckBox Content="Coração de Pedra: a mesa já contabilizou o ponto agravado da vela" IsChecked="{Binding CoreRitualCandleDamageConfirmed}"/>
            <CheckBox Content="Narrador confirmou tempo, ingredientes, alvo, oposição, validade e gatilho desta etapa" IsChecked="{Binding CoreRitualConditionsConfirmed}"/>
            <Button Content="Resolver próxima etapa / afirmação" Command="{Binding ResolveRitualWorkflowCommand}" HorizontalAlignment="Left"/>
            <Button Content="Coração de Pedra: aplicar cura crítica da vela confirmada" Command="{Binding ApplyRitualCandleHealingCommand}" HorizontalAlignment="Left"/>
            <Button Content="Essência do Ar: consumir uma dose confirmada" Command="{Binding ConsumeRitualAirDoseCommand}" HorizontalAlignment="Left"/>
            <Button Content="Essência do Ar: confirmar fim da noite e descartar doses" Command="{Binding ExpireRitualAirPotionCommand}" HorizontalAlignment="Left"/>
            <Expander Header="Aderência do Inseto: encerramento" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="Selecione o efeito e confirme a condição correta. Sucesso normal dura uma cena; vitória crítica dura a noite inteira e usa a noite da crônica informada acima. Fonte: Livro base, p. 276." TextWrapping="Wrap"/>
                <Button Content="Confirmar fim da cena (sucesso normal)" Command="{Binding EndClingingAfterSceneCommand}" HorizontalAlignment="Left"/>
                <Button Content="Confirmar fim da noite (vitória crítica)" Command="{Binding EndClingingAfterNightCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <Expander Header="Olhos de Babel: expiração" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="Selecione o efeito, informe acima a data atual da crônica e confirme com a mesa. O efeito dura uma semana; vitória crítica dura um mês. O app usa a data da resolução salva na ficha, não o relógio real. Fonte: Livro base, p. 277." TextWrapping="Wrap"/>
                <CheckBox Content="Narrador autorizou encerramento excepcional antes do prazo ou sem data de início" IsChecked="{Binding RitualEndingExceptionApproved}"/>
                <TextBox Text="{Binding RitualEndingExceptionReason, UpdateSourceTrigger=PropertyChanged}" ToolTip="Justificativa obrigatória da decisão excepcional" TextWrapping="Wrap"/>
                <Button Content="Confirmar data e encerrar se a duração terminou" Command="{Binding ExpireEyesOfBabelCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <Expander Header="Comunicação com o Senhor: encerramento" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="Selecione a conexão ativa e confirme com a mesa qual condição ocorreu. A comunicação dura dez minutos e qualquer perturbação em qualquer um dos lados encerra a conexão. O app não usa um relógio real nem presume a perturbação. Fonte: Livro base, p. 277." TextWrapping="Wrap"/>
                <Button Content="Confirmar que os dez minutos terminaram" Command="{Binding EndSireCommunicationAfterTenMinutesCommand}" HorizontalAlignment="Left"/>
                <Button Content="Confirmar perturbação em um dos lados" Command="{Binding EndSireCommunicationAfterDisturbanceCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <Expander Header="Verdade do Sangue: encerramento" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="Selecione o ritual com afirmações ativas e confirme o fim da cena. Uma falha em qualquer disputa já encerra o ritual; no fim da cena, a mistura vira cinzas. O app não inventa respostas nem recupera memórias. Fonte: Livro base, pp. 277–278." TextWrapping="Wrap"/>
                <Button Content="Confirmar fim da cena e encerrar afirmações" Command="{Binding EndTruthOfBloodAfterSceneCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <Expander Header="O Chamado de Dagon: encerrar repetições" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="Depois da primeira execução, o conjurador pode repetir o processo até mais duas vezes; cada repetição exige outra Checagem de Sangue. Selecione o preparo na etapa de repetição e confirme quando o conjurador não fará outra. O dano continua sendo apenas uma proposta para a ficha do alvo. Fonte: Livro base, p. 278." TextWrapping="Wrap"/>
                <Button Content="Confirmar que não haverá outra repetição" Command="{Binding FinishDagonRepetitionsCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <Expander Header="Andarilho do Fogo: encerramento" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="Selecione o efeito ativo, informe acima a noite da crônica que terminou e confirme com a mesa. A resistência vale somente pelo restante daquela noite. Fonte: Livro base, p. 278." TextWrapping="Wrap"/>
                <Button Content="Confirmar fim da noite e encerrar resistência" Command="{Binding EndFirewalkerAfterNightCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <Expander Header="Deflecção da Ruína de Madeira: encerramento" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="O teste só deve ser resolvido na primeira tentativa genuína de estaquear. Antes desse gatilho, selecione a proteção e confirme com a mesa se ela terminou pelo fim da noite ou pela remoção da lasca sob a língua. Fonte: Livro base, pp. 278–279." TextWrapping="Wrap"/>
                <Button Content="Confirmar fim da noite sem acionamento" Command="{Binding EndDeflectionAfterNightCommand}" HorizontalAlignment="Left"/>
                <Button Content="Confirmar remoção da lasca sob a língua" Command="{Binding EndDeflectionAfterSplinterRemovedCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <Expander Header="Essência do Ar: passageiro involuntário" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="Selecione o registro de consumo ativo. Identifique o passageiro no campo 'Alvo / objeto / local' acima. Informe Força + Feitiçaria de Sangue do conjurador, a Fome dele e, acima, os sucessos de Força + Atletismo do passageiro. Confirme a situação com o Narrador. O resultado é apenas uma proposta; nenhuma ficha é movida. Fonte: Livro base, p. 279." TextWrapping="Wrap"/>
                <TextBlock Text="Força + Feitiçaria de Sangue do conjurador"/><controls:NumericField Value="{Binding RitualAirPassengerPool}" Minimum="0" Maximum="50"/>
                <TextBlock Text="Fome do conjurador"/><controls:NumericField Value="{Binding RitualAirPassengerHunger}" Minimum="0" Maximum="5"/>
                <CheckBox Content="A mesa confirmou que a Besta do conjurador está subjugada" IsChecked="{Binding RitualAirPassengerBeastSubdued}"/>
                <Button Content="Resolver disputa confirmada do passageiro" Command="{Binding ResolveRitualAirPassengerContestCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <Expander Header="Essência do Ar: puxar o conjurador ao solo" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="Selecione o consumo ativo e identifique no campo 'Alvo / objeto / local' quem tenta puxar o conjurador. Informe Força + Atletismo dessa pessoa, sua Fome (0 para mortal) e os sucessos confirmados de Força + Feitiçaria de Sangue do conjurador. Quem puxa é o personagem ativo e vence empates. O resultado é somente uma proposta; nenhuma posição ou ficha é alterada. Fonte: Livro base, pp. 121 e 279." TextWrapping="Wrap"/>
                <TextBlock Text="Força + Atletismo de quem puxa"/><controls:NumericField Value="{Binding RitualAirGrounderPool}" Minimum="0" Maximum="50"/>
                <TextBlock Text="Fome de quem puxa"/><controls:NumericField Value="{Binding RitualAirGrounderHunger}" Minimum="0" Maximum="5"/>
                <TextBlock Text="Sucessos de Força + Feitiçaria de Sangue do conjurador"/><controls:NumericField Value="{Binding RitualAirCasterSuccesses}" Minimum="0" Maximum="100"/>
                <CheckBox Content="A mesa confirmou que a Besta de quem puxa está subjugada" IsChecked="{Binding RitualAirGrounderBeastSubdued}"/>
                <Button Content="Resolver tentativa confirmada de puxar ao solo" Command="{Binding ResolveRitualAirGroundingContestCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <Expander Header="Passagem Incorpórea: materialização" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="Selecione o efeito ativo. Confirme se ele terminou porque a cena acabou ou porque o caco foi largado. Se o conjurador estiver dentro de matéria sólida, registre abaixo a decisão do Narrador; o app não inventa nem aplica essa consequência. Fonte: Livro base, p. 280." TextWrapping="Wrap"/>
                <CheckBox Content="O caco foi largado (desmarcado: fim da cena)" IsChecked="{Binding RitualIncorporealShardReleased}"/>
                <CheckBox Content="A materialização ocorreu dentro de matéria sólida" IsChecked="{Binding RitualIncorporealInsideSolid}"/>
                <TextBlock Text="Decisão do Narrador sobre a materialização em matéria sólida"/>
                <TextBox Text="{Binding RitualIncorporealNarratorResolution, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                <Button Content="Confirmar materialização e encerrar o efeito" Command="{Binding EndRitualIncorporealPassageCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <Expander Header="Defesa do Refúgio Sagrado: encerramento" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="Selecione a proteção ativa e confirme com a mesa qual condição ocorreu. O efeito dura um dia, mas termina imediatamente se o conjurador deixar a área. Fonte: Livro base, p. 279." TextWrapping="Wrap"/>
                <Button Content="Confirmar fim do dia protegido" Command="{Binding EndSacredHavenAfterDayCommand}" HorizontalAlignment="Left"/>
                <Button Content="Confirmar que o conjurador deixou a área" Command="{Binding EndSacredHavenAfterCasterLeftCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <Button Content="Iluminar Rastro: rolar Inteligência + Sobrevivência" Command="{Binding RollRitualTrackingCommand}" HorizontalAlignment="Left"/>
            <Expander Header="Iluminar o Rastro da Presa: expiração" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="Selecione o rastro ativo, informe acima a noite da crônica que terminou e confirme com a mesa. O rastro permanece visível pela noite do ritual; vitória crítica inclui a segunda noite. O app não presume que o trajeto ainda é válido. Fonte: Livro base, p. 277." TextWrapping="Wrap"/>
                <CheckBox Content="Narrador autorizou encerramento excepcional antes do prazo ou sem noite de início" IsChecked="{Binding RitualEndingExceptionApproved}"/>
                <TextBox Text="{Binding RitualEndingExceptionReason, UpdateSourceTrigger=PropertyChanged}" ToolTip="Justificativa obrigatória da decisão excepcional" TextWrapping="Wrap"/>
                <Button Content="Confirmar fim da noite e encerrar quando a duração terminar" Command="{Binding ExpireIlluminatedTrailCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <Expander Header="Olhos do Falcão Noturno: encerramento" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="Selecione o voo ativo, informe acima a noite da crônica que terminou e confirme as circunstâncias com o Narrador. Escolha explicitamente o que ocorreu com os olhos da ave. Fonte: Livro base, p. 280." TextWrapping="Wrap"/>
                <Button Content="Fim da noite: olhos da ave removidos" Command="{Binding EndNighthawkWithEyesRemovedCommand}" HorizontalAlignment="Left"/>
                <Button Content="Fim da noite: olhos da ave NÃO removidos" Command="{Binding EndNighthawkWithoutEyesRemovedCommand}" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding RitualBlindnessSummary}" TextWrapping="Wrap" Margin="0,8"/>
                <TextBlock Text="Para a cegueira, selecione seu registro, informe a última noite concluída e confirme o avanço. A mesma noite não será descontada novamente; saltos de data contam as noites transcorridas que a mesa confirmou. Nenhum modificador numérico de cegueira é presumido." TextWrapping="Wrap"/>
                <Button Content="Confirmar noites concluídas da cegueira" Command="{Binding AdvanceRitualBlindnessNightsCommand}" HorizontalAlignment="Left"/>
                <CheckBox Content="Narrador autorizou encerrar esta cegueira antes do prazo" IsChecked="{Binding RitualEndingExceptionApproved}"/>
                <TextBox Text="{Binding RitualEndingExceptionReason, UpdateSourceTrigger=PropertyChanged}" ToolTip="Justificativa desta decisão excepcional" TextWrapping="Wrap"/>
                <Button Content="Encerrar cegueira por exceção justificada" Command="{Binding EndRitualBlindnessByRulingCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <Expander Header="Fuste: ataque ou extração da lasca" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="Antes das duas Checagens, confirme e grave o preparo específico. A confirmação fica na ficha e não precisa ser refeita ao alternar entre efeitos. Fonte: Livro base, p. 281." TextWrapping="Wrap"/>
                <CheckBox Content="Estaca de sorveira com runas perniciosas confirmada" IsChecked="{Binding RitualShaftRowanStakeConfirmed}"/>
                <CheckBox Content="Escurecimento em fogo de carvalho confirmado" IsChecked="{Binding RitualShaftOakFireConfirmed}"/>
                <CheckBox Content="Cinco horas de preparo confirmadas" IsChecked="{Binding RitualShaftFiveHoursConfirmed}"/>
                <Button Content="Confirmar preparo específico do Fuste" Command="{Binding ConfirmRitualShaftPreparationCommand}" HorizontalAlignment="Left"/>
                <TextBlock Text="Ataque: informe a parada de quem usa a estaca, sem o bônus ritual (+3 é acrescentado). Use os sucessos da oposição acima. Cirurgia: informe Destreza + Medicina de outra pessoa e confirme até quatro horas disponíveis. Identifique a Fome do executor, 0 para mortal. Não há alteração automática na vítima." TextWrapping="Wrap"/>
                <TextBlock Text="Parada do executor"/><controls:NumericField Value="{Binding RitualFollowUpPool}" Minimum="0" Maximum="47"/>
                <TextBlock Text="Fome do executor"/><controls:NumericField Value="{Binding RitualFollowUpHunger}" Minimum="0" Maximum="5"/>
                <CheckBox Content="A mesa confirmou que a Besta deste executor está subjugada" IsChecked="{Binding RitualFollowUpBeastSubdued}"/>
                <TextBlock Text="Aplica a imunidade a crítico bestial somente à rolagem deste executor, inclusive se for outra pessoa. Fonte: Livro base, p. 246." TextWrapping="Wrap"/>
                <Button Content="Rolar ataque com estaca ritual confirmado" Command="{Binding RollRitualShaftAttackCommand}" HorizontalAlignment="Left"/>
                <Button Content="Rolar cirurgia de extração confirmada" Command="{Binding RollRitualShaftSurgeryCommand}" HorizontalAlignment="Left"/>
                <TextBlock Text="Sem médico, a mesa pode registrar a remoção por amputação somente enquanto a lasca ainda não alcançou o tronco. Esta opção não faz rolagem nem altera a ficha da vítima. Fonte: Livro base, p. 282." TextWrapping="Wrap" Margin="0,8,0,0"/>
                <CheckBox Content="Mesa confirmou que não há médico disponível para extrair a lasca" IsChecked="{Binding RitualShaftDoctorUnavailableConfirmed}"/>
                <CheckBox Content="Mesa confirmou que a lasca ainda não alcançou o tronco" IsChecked="{Binding RitualShaftBeforeTrunkConfirmed}"/>
                <CheckBox Content="Mesa confirmou que o membro afetado foi amputado para remover a lasca" IsChecked="{Binding RitualShaftAmputationConfirmed}"/>
                <Button Content="Registrar remoção da lasca por amputação" Command="{Binding ResolveRitualShaftAmputationCommand}" HorizontalAlignment="Left"/>
                <TextBlock Text="Consequências finais permanecem propostas: confirme a condição correspondente ao estado salvo, sem alterar automaticamente a vítima. Fonte: Livro base, p. 282." TextWrapping="Wrap" Margin="0,8,0,0"/>
                <CheckBox Content="Narrador confirmou que a lasca alcançou o coração após o tempo por ele determinado" IsChecked="{Binding RitualShaftReachedHeartConfirmed}"/>
                <Button Content="Registrar chegada da lasca ao coração" Command="{Binding ConfirmRitualShaftReachedHeartCommand}" HorizontalAlignment="Left"/>
                <CheckBox Content="Narrador confirmou que passou um turno após a penetração com margem 5+" IsChecked="{Binding RitualShaftTurnElapsedConfirmed}"/>
                <Button Content="Registrar consequência após um turno" Command="{Binding ConfirmRitualShaftFinalDeathAfterTurnCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <Expander Header="Travessia de círculo preparado" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="Identifique um intruso do tipo correspondente. A orientação foi salva no preparo; a mesa ainda confirma posição, elegibilidade e tentativas anteriores. Danos e custos do intruso são propostas, sem alterar outra ficha." TextWrapping="Wrap"/>
                <TextBlock Text="Intruso"/><TextBox Text="{Binding CoreRitualIntruder, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Parada de Vontade do intruso"/><controls:NumericField Value="{Binding CoreRitualIntruderWillpower}" Minimum="0" Maximum="50"/>
                <CheckBox Content="O intruso está tentando sair do círculo" IsChecked="{Binding CoreRitualIntruderAttemptingToExit}"/>
                <CheckBox Content="Nova tentativa de intruso afetado que ainda não atravessou" IsChecked="{Binding CoreRitualRetry}"/>
                <CheckBox Content="Mesa confirmou gasto de 1 Vontade do intruso para repetir" IsChecked="{Binding CoreRitualRetryCostConfirmed}"/>
                <Button Content="Resolver disputa de travessia confirmada" Command="{Binding ResolveRitualCircleContactCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <Expander Header="Círculo de Proteção: expiração" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="Selecione um círculo ativo e informe acima a data da crônica. O círculo comum só é encerrado após a mesa confirmar o amanhecer; a versão estendida usa a data de resolução salva para validar um ano e um dia. O relógio real não é consultado. Fonte: Livro base, p. 275." TextWrapping="Wrap"/>
                <CheckBox Content="Narrador autorizou encerramento excepcional antes do prazo ou sem data de início" IsChecked="{Binding RitualEndingExceptionApproved}"/>
                <TextBox Text="{Binding RitualEndingExceptionReason, UpdateSourceTrigger=PropertyChanged}" ToolTip="Justificativa obrigatória da decisão excepcional" TextWrapping="Wrap"/>
                <Button Content="Confirmar amanhecer ou validar um ano e um dia" Command="{Binding ExpireProtectionCircleCommand}" HorizontalAlignment="Left"/>
            </StackPanel></Expander>
            <TextBlock Text="Durações em horas, noites, doses e condições narrativas precisam de acompanhamento da mesa. Encerre o efeito no registro quando expirar. Exceções ficam na ficha; outras fichas nunca são modificadas por estes controles." TextWrapping="Wrap" Foreground="{DynamicResource ThemeInputDescription}"/>
            <Expander Header="Contexto dos efeitos em uso" Margin="0,8"><StackPanel Margin="8">
                <TextBlock Text="Coração de Pedra: os ajustes abaixo entram na parada montada da mesa de dados. Remorso aplica −3 automaticamente, com mínimo de um dado. Dominação usa o procedimento do poder, sem a penalidade social. A reversão exige repetir o ritual e encerrar o efeito anterior." TextWrapping="Wrap"/>
                <CheckBox Content="Teste social ativo (−3; Intimidação é isenta)" IsChecked="{Binding RitualActiveSocialTest}"/>
                <CheckBox Content="Este teste é resistência contra Presença (+3)" IsChecked="{Binding RitualResistingPresence}"/>
                <CheckBox Content="O dano físico a aplicar é de fogo (Andarilho do Fogo)" IsChecked="{Binding RitualIncomingDamageIsFire}"/>
                <CheckBox Content="A ficha está dentro do Refúgio Sagrado ativo, com o conjurador ainda presente" IsChecked="{Binding RitualInsideProtectedHaven}"/>
                <TextBlock Text="Passagem Incorpórea impede Surto de Sangue e protege de fontes físicas comuns. Fogo, sol e efeitos arcanos devem ser identificados no contexto do dano." TextWrapping="Wrap"/>
            </StackPanel></Expander>
        </StackPanel>
    </Border>
</UserControl>
