<UserControl x:Class="VCS.Desktop.Shell.WorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sheet="clr-namespace:VCS.Desktop.Sheet"
    xmlns:controls="clr-namespace:VCS.Desktop.Controls"
    xmlns:shell="clr-namespace:VCS.Desktop.Shell"
    xmlns:themes="clr-namespace:VCS.Desktop.Themes">
    <UserControl.Resources>
        <Style x:Key="WorkspaceOverlayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource VcsOuterText}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.75" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Display.WorkspaceBackgroundIsDark}" Value="True"><Setter Property="Foreground" Value="White" /></DataTrigger>
                <DataTrigger Binding="{Binding Display.WorkspaceBackgroundIsDark}" Value="False"><Setter Property="Foreground" Value="Black" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <ItemsPanelTemplate x:Key="TiledSheetPanel"><UniformGrid Columns="{Binding DataContext.LayoutColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" /></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="FloatingSheetPanel"><Canvas ClipToBounds="True" /></ItemsPanelTemplate>
    </UserControl.Resources>
    <!-- Open sheet tabs, the home view and every open sheet (alone or side by side). -->
    <DockPanel Margin="16,8,16,16">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5" Visibility="{Binding HasOpenEditors, Converter={StaticResource BoolVisibility}}">
        <Button Style="{StaticResource WorkspaceOverlayButton}" DockPanel.Dock="Right" Content="▣" Width="30" Height="26" Padding="0" Margin="4,0,0,0" Background="Transparent" BorderThickness="0"
                ToolTip="Alternar janelas flutuantes" AutomationProperties.Name="Alternar janelas flutuantes" Command="{Binding ToggleFloatingWindowsCommand}" />
        <Button Style="{StaticResource WorkspaceOverlayButton}" DockPanel.Dock="Right" Content="◫" Width="30" Height="26" Padding="0" Margin="4,0,0,0" Background="Transparent" BorderThickness="0"
                ToolTip="Alternar fichas lado a lado" AutomationProperties.Name="Alternar fichas lado a lado" Command="{Binding ToggleSplitWindowsCommand}" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal">
    <ItemsControl ItemsSource="{Binding OpenEditors}" Margin="0"
                  Visibility="{Binding HasOpenEditors, Converter={StaticResource BoolVisibility}}"
                  AutomationProperties.Name="Fichas abertas">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border x:Name="Tab" Margin="0,0,2,0" CornerRadius="4,4,0,0" BorderThickness="0,0,0,1" Padding="6,0,2,0" MinHeight="26" AllowDrop="True" PreviewMouseLeftButtonDown="OnTabMouseDown" PreviewMouseMove="OnTabMouseMove" Drop="OnTabDrop"
                        BorderBrush="{DynamicResource VcsBorder}" Background="{DynamicResource VcsCard}">
                    <StackPanel Orientation="Horizontal">
                        <Button Background="Transparent" BorderThickness="0" Padding="0" MinHeight="0" MaxWidth="140"
                                Command="{Binding DataContext.ActivateEditorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding TabTitle, StringFormat='Aba {0}'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="NPC" FontSize="10" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource VcsAccentText}"
                                           Visibility="{Binding IsNpc, Converter={StaticResource BoolVisibility}}" />
                                <TextBlock x:Name="TabTitleText" Text="{Binding TabTitle}" TextTrimming="CharacterEllipsis" FontSize="12"
                                           Foreground="{DynamicResource VcsCardText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="×" Width="20" Height="20" MinHeight="0" Padding="0" Margin="4,0,0,0" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource VcsInputDescription}" ToolTip="Fechar ficha"
                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding TabTitle, StringFormat='Fechar {0}'}" />
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource VcsAccentBorder}" />
                        <Setter TargetName="Tab" Property="BorderThickness" Value="0,0,0,2" />
                        <Setter TargetName="Tab" Property="Background" Value="{DynamicResource VcsSelection}" />
                        <Setter TargetName="TabTitleText" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
        <Button Style="{StaticResource WorkspaceOverlayButton}" Content="+" Width="26" Height="26" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0"
                ToolTip="Novo personagem" AutomationProperties.Name="Novo personagem" Command="{Binding CreateCommand}" />
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
    <Grid>
    <shell:HomeView Visibility="{Binding IsHome, Converter={StaticResource BoolVisibility}}" />
    <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolVisibility}}" AllowDrop="True" Drop="OnWorkspaceDrop">
        <!-- One host for every open sheet: each sheet is built once, then shown alone or side by side.
             Switching sheets or turning bento on/off only changes visibility and columns. -->
        <ItemsControl ItemsSource="{Binding OpenEditors}" Focusable="False" Background="Transparent" AutomationProperties.Name="Fichas lado a lado">
            <ItemsControl.ContextMenu>
                <ContextMenu>
                    <themes:SheetThemeMenu />
                    <themes:AppThemeMenu />
                </ContextMenu>
            </ItemsControl.ContextMenu>
            <ItemsControl.Style><Style TargetType="ItemsControl">
                <Setter Property="ItemsPanel" Value="{StaticResource TiledSheetPanel}" />
                <Style.Triggers><DataTrigger Binding="{Binding FloatingWindows}" Value="True">
                    <Setter Property="ItemsPanel" Value="{StaticResource FloatingSheetPanel}" />
                </DataTrigger></Style.Triggers>
            </Style></ItemsControl.Style>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Visible" /><Setter Property="Panel.ZIndex" Value="1" /></DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.FloatingWindows, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                            <Setter Property="Visibility" Value="Visible" /><Setter Property="Width" Value="{Binding FloatingWidth}" /><Setter Property="Height" Value="{Binding FloatingHeight}" />
                            <Setter Property="Canvas.Left" Value="{Binding FloatingX}" /><Setter Property="Canvas.Top" Value="{Binding FloatingY}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.IsSideBySide, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Alone, the sheet is a rounded surface in its own theme; side by side it becomes a card. -->
                    <Border x:Name="Pane" CornerRadius="12" themes:SheetTheme.Id="{Binding EffectiveSheetThemeId}"
                            BorderBrush="{DynamicResource VcsBorder}"
                            BorderThickness="1" Padding="18,14,8,12"
                            TextElement.Foreground="{DynamicResource VcsCardText}" PreviewMouseDown="OnSheetPaneMouseDown"
                            AutomationProperties.Name="{Binding TabTitle, StringFormat='Painel {0}'}">
                        <Border.Style><Style TargetType="Border"><Setter Property="Tag" Value="{DynamicResource VcsBackground}" /></Style></Border.Style>
                        <Border.Background><MultiBinding Converter="{StaticResource SurfaceOpacityConverter}"><Binding RelativeSource="{RelativeSource Self}" Path="Tag" /><Binding Path="DataContext.Display.SurfaceOpacity" RelativeSource="{RelativeSource AncestorType=Window}" /></MultiBinding></Border.Background>
                        <DockPanel>
                            <DockPanel x:Name="PaneHeader" DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="Collapsed" PreviewMouseLeftButtonDown="OnTabMouseDown" PreviewMouseMove="OnTabMouseMove">
                                <Button DockPanel.Dock="Right" Content="×" Width="22" Height="22" Padding="0" Background="Transparent"
                                        BorderThickness="0" Foreground="{DynamicResource VcsInputDescription}" ToolTip="Fechar ficha"
                                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding TabTitle, StringFormat='Fechar painel {0}'}" />
                                <Button DockPanel.Dock="Right" Content="Exibir ▾" Padding="4,0" MinHeight="22" Margin="0,0,6,0" Background="Transparent" BorderThickness="0" Click="OnWindowViewMenu" AutomationProperties.Name="Modo de visualização da ficha">
                                    <Button.ContextMenu><ContextMenu>
                                        <MenuItem Header="Usar configuração geral" Tag="Default" Click="OnWindowViewSelected" />
                                        <MenuItem Header="Lista" Tag="Continuous" Click="OnWindowViewSelected" />
                                        <MenuItem Header="Abas" Tag="Tabbed" Click="OnWindowViewSelected" />
                                        <MenuItem Header="Bento" Tag="Bento" Click="OnWindowViewSelected" />
                                    </ContextMenu></Button.ContextMenu>
                                </Button>
                                <Thumb DockPanel.Dock="Left" Width="20" Height="24" Margin="0,0,6,0" Cursor="SizeAll" DragDelta="OnFloatingDragDelta" ToolTip="Mover janela" AutomationProperties.Name="Mover janela">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><TextBlock Text="⋮⋮" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource VcsInputDescription}" /></Border></ControlTemplate></Thumb.Template>
                                    <Thumb.Style><Style TargetType="Thumb"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.FloatingWindows, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Thumb.Style>
                                </Thumb>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="11" Margin="0,0,8,0"
                                           Foreground="{DynamicResource VcsInputDescription}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TabTitle}" FontFamily="Georgia" FontSize="15" FontStyle="Italic"
                                           Foreground="{DynamicResource VcsAccentText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <Thumb DockPanel.Dock="Bottom" Width="18" Height="18" HorizontalAlignment="Right" Cursor="SizeNWSE" DragDelta="OnFloatingResizeDelta" ToolTip="Redimensionar janela" AutomationProperties.Name="Redimensionar janela">
                                <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><TextBlock Text="◢" FontSize="12" Foreground="{DynamicResource VcsInputDescription}" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></Border></ControlTemplate></Thumb.Template>
                                <Thumb.Style><Style TargetType="Thumb"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.FloatingWindows, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Thumb.Style>
                            </Thumb>
                            <sheet:CharacterEditorView x:Name="Sheet" />
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsSideBySide, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                            <Setter TargetName="Pane" Property="Margin" Value="4" />
                            <Setter TargetName="Pane" Property="CornerRadius" Value="8" />
                            <Setter TargetName="Pane" Property="Padding" Value="10,6,6,8" />
                            <Setter TargetName="Pane" Property="BorderThickness" Value="1" />
                            <Setter TargetName="Pane" Property="BorderBrush" Value="{DynamicResource VcsBorder}" />
                            <Setter TargetName="Pane" Property="Tag" Value="{DynamicResource VcsCard}" />
                            <Setter TargetName="PaneHeader" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Sheet" Property="IsPane" Value="True" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.FloatingWindows, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                            <Setter TargetName="Pane" Property="Margin" Value="2" /><Setter TargetName="Pane" Property="CornerRadius" Value="8" />
                            <Setter TargetName="Pane" Property="Padding" Value="10,6,6,8" /><Setter TargetName="Pane" Property="Tag" Value="{DynamicResource VcsCard}" />
                            <Setter TargetName="PaneHeader" Property="Visibility" Value="Visible" /><Setter TargetName="Sheet" Property="IsPane" Value="True" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding DataContext.IsSideBySide, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                                <Condition Binding="{Binding IsActive}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Pane" Property="BorderBrush" Value="{DynamicResource VcsAccentBorder}" />
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,12"
                Width="456" MaxHeight="360" Padding="12" CornerRadius="12"
                Background="{DynamicResource VcsCard}" BorderBrush="{DynamicResource VcsBorder}"
                BorderThickness="1" Panel.ZIndex="20" AutomationProperties.Name="Mesa de rolagem 3D"
                themes:SheetTheme.Id="{Binding Editor.EffectiveSheetThemeId}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Editor.HasRollDisplay}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="MESA DE DADOS" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource VcsInputDescription}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Display.Show3DDice}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="RESULTADO DA ROLAGEM" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource VcsInputDescription}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Display.Show3DDice}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Editor.LastRollLabel}" FontFamily="Georgia" FontSize="16"
                                   Foreground="{DynamicResource VcsCardText}" />
                    </StackPanel>
                    <Button Content="×" Width="26" Height="26" Padding="0" HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0" Foreground="{DynamicResource VcsInputDescription}"
                            ToolTip="Fechar visualização dos dados" Command="{Binding Editor.ClearRolledDiceCommand}"
                            AutomationProperties.Name="Fechar mesa de dados" />
                </Grid>
                <Border Background="{DynamicResource VcsBackground}" BorderBrush="{DynamicResource VcsBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Display.Show3DDice}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ScrollViewer MaxHeight="192" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Editor.RolledDice}"
                                      AutomationProperties.Name="Resultados dos dados tridimensionais">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><controls:Dice3DView /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <TextBlock Text="{Binding Editor.LastRollSummary}" Margin="4,8,4,2"
                           TextWrapping="Wrap" Foreground="{DynamicResource VcsCardText}"
                           AutomationProperties.Name="Resultado da rolagem" />
                <StackPanel Margin="4,6,4,0">
                    <ItemsControl ItemsSource="{Binding Editor.RerollableDice}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,10,4"
                                          AutomationProperties.Name="Selecionar dado comum falho para rerrolagem">
                                    <TextBlock Text="{Binding Face, StringFormat='Dado comum falho: {0}'}" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Rerrolar até 3 dados comuns (1 dano de Vontade)"
                            Command="{Binding Editor.RerollFailuresCommand}"
                            IsEnabled="{Binding Editor.CanReroll}" HorizontalAlignment="Left" Margin="0,2,0,0"
                            AutomationProperties.Name="Rerrolar falhas comuns usando Vontade" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </DockPanel>
</UserControl>
