<UserControl x:Class="Game.Desktop.Shell.StatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Error, status message, update notice and busy indicator. -->
    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ThemeBorder}" Padding="12,2" TextElement.Foreground="{DynamicResource ThemeFooterText}">
        <StackPanel>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ThemeAccentText}" TextWrapping="Wrap" Margin="0,0,0,4">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                    <DataTrigger Binding="{Binding Error}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Atualizar" Command="{Binding UpdateCommand}" Margin="12,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AvailableUpdate}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource ThemeFooterText}" TextWrapping="Wrap" FontSize="12"
                           VerticalAlignment="Center" Margin="0" />
            </DockPanel>
            <ProgressBar Height="3" IsIndeterminate="True" Margin="0,6,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
    </Border>
</UserControl>
