<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#101914" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#FFD86A" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#FFD86A" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#FFD86A" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#1A2821" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#FFD86A" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#A0061B" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#101914" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#FFD86A" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#FFD86A" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#FFD86A" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#FFD86A" />
    <SolidColorBrush x:Key="VcsAppDieNumber" Color="#101914" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#FFD86A" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#A0061B" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#A0061B" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#28604C" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#780514" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#FFD86A" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#780514" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#101914" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#FFD86A" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#1A2821" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#FFD86A" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#A0061B" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#101914" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#FFD86A" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#FFD86A" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#FFD86A" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#FFD86A" />
    <SolidColorBrush x:Key="VcsSheetDieNumber" Color="#101914" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#FFD86A" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#A0061B" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#A0061B" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#28604C" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#780514" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#FFD86A" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#780514" />
</ResourceDictionary>
