<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A aplicacao herda as cores da ficha; somente diferencas sao declaradas aqui. -->

    <!-- Cores da ficha e valores base compartilhados. -->
    <SolidColorBrush x:Key="ThemeSheetBackground" Color="#F5F5F5" />
    <SolidColorBrush x:Key="ThemeSheetOuterText" Color="#111111" />
    <SolidColorBrush x:Key="ThemeSheetCard" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSheetCardText" Color="#111111" />
    <SolidColorBrush x:Key="ThemeSheetBorder" Color="#858585" />
    <SolidColorBrush x:Key="ThemeSheetInput" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSheetInputText" Color="#111111" />
    <SolidColorBrush x:Key="ThemeSheetInputTitle" Color="#111111" />
    <SolidColorBrush x:Key="ThemeSheetInputDescription" Color="#505050" />
    <SolidColorBrush x:Key="ThemeSheetAccent" Color="#141414" />
    <SolidColorBrush x:Key="ThemeSheetDieNumber" Color="#FEF4E3" />
    <SolidColorBrush x:Key="ThemeSheetAccentText" Color="#141414" />
    <SolidColorBrush x:Key="ThemeSheetAccentBorder" Color="#141414" />
    <SolidColorBrush x:Key="ThemeSheetAccentHotbar" Color="#141414" />
    <SolidColorBrush x:Key="ThemeSheetHover" Color="#EEEEEE" />
    <SolidColorBrush x:Key="ThemeSheetSelection" Color="#DEDEDE" />
    <SolidColorBrush x:Key="ThemeSheetSelectionText" Color="#111111" />
    <SolidColorBrush x:Key="ThemeSheetScroll" Color="#505050" />
</ResourceDictionary>
