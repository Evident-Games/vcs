<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A aplicacao herda as cores da ficha; somente diferencas sao declaradas aqui. -->

    <!-- Cores da ficha e valores base compartilhados. -->
    <SolidColorBrush x:Key="ThemeSheetBackground" Color="#FFF9F7" />
    <SolidColorBrush x:Key="ThemeSheetOuterText" Color="#252126" />
    <SolidColorBrush x:Key="ThemeSheetCard" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSheetCardText" Color="#252126" />
    <SolidColorBrush x:Key="ThemeSheetBorder" Color="#B6A5AB" />
    <SolidColorBrush x:Key="ThemeSheetInput" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSheetInputText" Color="#252126" />
    <SolidColorBrush x:Key="ThemeSheetInputTitle" Color="#252126" />
    <SolidColorBrush x:Key="ThemeSheetInputDescription" Color="#655A60" />
    <SolidColorBrush x:Key="ThemeSheetAccent" Color="#A7132B" />
    <SolidColorBrush x:Key="ThemeSheetDieNumber" Color="#FEF4E3" />
    <SolidColorBrush x:Key="ThemeSheetAccentText" Color="#A7132B" />
    <SolidColorBrush x:Key="ThemeSheetAccentBorder" Color="#A7132B" />
    <SolidColorBrush x:Key="ThemeSheetAccentHotbar" Color="#A7132B" />
    <SolidColorBrush x:Key="ThemeSheetHover" Color="#F6ECEE" />
    <SolidColorBrush x:Key="ThemeSheetSelection" Color="#F1DCE1" />
    <SolidColorBrush x:Key="ThemeSheetSelectionText" Color="#252126" />
    <SolidColorBrush x:Key="ThemeSheetScroll" Color="#655A60" />
</ResourceDictionary>
