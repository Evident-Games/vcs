<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A aplicacao herda as cores da ficha; somente diferencas sao declaradas aqui. -->

    <!-- Cores da ficha e valores base compartilhados. -->
    <SolidColorBrush x:Key="ThemeSheetBackground" Color="#F4E6B5" />
    <SolidColorBrush x:Key="ThemeSheetOuterText" Color="#302724" />
    <SolidColorBrush x:Key="ThemeSheetCard" Color="#FFF5D6" />
    <SolidColorBrush x:Key="ThemeSheetCardText" Color="#302724" />
    <SolidColorBrush x:Key="ThemeSheetBorder" Color="#A48D62" />
    <SolidColorBrush x:Key="ThemeSheetInput" Color="#FFFAE8" />
    <SolidColorBrush x:Key="ThemeSheetInputText" Color="#302724" />
    <SolidColorBrush x:Key="ThemeSheetInputTitle" Color="#302724" />
    <SolidColorBrush x:Key="ThemeSheetInputDescription" Color="#68513D" />
    <SolidColorBrush x:Key="ThemeSheetAccent" Color="#97142B" />
    <SolidColorBrush x:Key="ThemeSheetDieNumber" Color="#FEF4E3" />
    <SolidColorBrush x:Key="ThemeSheetAccentText" Color="#97142B" />
    <SolidColorBrush x:Key="ThemeSheetAccentBorder" Color="#97142B" />
    <SolidColorBrush x:Key="ThemeSheetAccentHotbar" Color="#97142B" />
    <SolidColorBrush x:Key="ThemeSheetHover" Color="#F2DFB8" />
    <SolidColorBrush x:Key="ThemeSheetSelection" Color="#EED2B1" />
    <SolidColorBrush x:Key="ThemeSheetSelectionText" Color="#302724" />
    <SolidColorBrush x:Key="ThemeSheetScroll" Color="#68513D" />
</ResourceDictionary>
