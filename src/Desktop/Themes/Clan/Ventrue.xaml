<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A aplicacao herda as cores da ficha; somente diferencas sao declaradas aqui. -->

    <!-- Cores da ficha e valores base compartilhados. -->
    <SolidColorBrush x:Key="ThemeSheetBackground" Color="#F5F2EF" />
    <SolidColorBrush x:Key="ThemeSheetOuterText" Color="#0F0D4F" />
    <SolidColorBrush x:Key="ThemeSheetCard" Color="#B09E4F" />
    <SolidColorBrush x:Key="ThemeSheetCardText" Color="#0F0D4F" />
    <SolidColorBrush x:Key="ThemeSheetBorder" Color="#B09E4F" />
    <SolidColorBrush x:Key="ThemeSheetInput" Color="#0F0D4F" />
    <SolidColorBrush x:Key="ThemeSheetInputText" Color="#0F0D4F" />
    <SolidColorBrush x:Key="ThemeSheetInputTitle" Color="#0F0D4F" />
    <SolidColorBrush x:Key="ThemeSheetInputDescription" Color="#7E6D5D" />
    <SolidColorBrush x:Key="ThemeSheetAccent" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ThemeSheetDieNumber" Color="#0C0B0D" />
    <SolidColorBrush x:Key="ThemeSheetAccentText" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ThemeSheetAccentBorder" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ThemeSheetAccentHotbar" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ThemeSheetHover" Color="#72171A" />
    <SolidColorBrush x:Key="ThemeSheetSelection" Color="#B29B9B" />
    <SolidColorBrush x:Key="ThemeSheetSelectionText" Color="#0F0D4F" />
    <SolidColorBrush x:Key="ThemeSheetScroll" Color="#7E6D5D" />
</ResourceDictionary>
