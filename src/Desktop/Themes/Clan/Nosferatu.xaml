<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A aplicacao herda as cores da ficha; somente diferencas sao declaradas aqui. -->

    <!-- Cores da ficha e valores base compartilhados. -->
    <SolidColorBrush x:Key="ThemeSheetBackground" Color="#0C0C0C" />
    <SolidColorBrush x:Key="ThemeSheetOuterText" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ThemeSheetCard" Color="#191919" />
    <SolidColorBrush x:Key="ThemeSheetCardText" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ThemeSheetBorder" Color="#AAAAAA" />
    <SolidColorBrush x:Key="ThemeSheetInput" Color="#000000" />
    <SolidColorBrush x:Key="ThemeSheetInputText" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ThemeSheetInputTitle" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ThemeSheetInputDescription" Color="#D8D8D8" />
    <SolidColorBrush x:Key="ThemeSheetAccent" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ThemeSheetDieNumber" Color="#0C0B0D" />
    <SolidColorBrush x:Key="ThemeSheetAccentText" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ThemeSheetAccentBorder" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ThemeSheetAccentHotbar" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ThemeSheetHover" Color="#0C0C0C" />
    <SolidColorBrush x:Key="ThemeSheetSelection" Color="#151515" />
    <SolidColorBrush x:Key="ThemeSheetSelectionText" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ThemeSheetScroll" Color="#D8D8D8" />
</ResourceDictionary>
