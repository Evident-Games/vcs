<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A aplicacao herda as cores da ficha; somente diferencas sao declaradas aqui. -->

    <!-- Cores da ficha e valores base compartilhados. -->
    <SolidColorBrush x:Key="ThemeSheetBackground" Color="#72171A" />
    <SolidColorBrush x:Key="ThemeSheetOuterText" Color="#B29D34" />
    <SolidColorBrush x:Key="ThemeSheetCard" Color="#23101B" />
    <SolidColorBrush x:Key="ThemeSheetCardText" Color="#FBF7F4" />
    <SolidColorBrush x:Key="ThemeSheetBorder" Color="#B29D34" />
    <SolidColorBrush x:Key="ThemeSheetInput" Color="#424242" />
    <SolidColorBrush x:Key="ThemeSheetInputText" Color="#FBF7F4" />
    <SolidColorBrush x:Key="ThemeSheetInputTitle" Color="#FBF7F4" />
    <SolidColorBrush x:Key="ThemeSheetInputDescription" Color="#B29D34" />
    <SolidColorBrush x:Key="ThemeSheetAccent" Color="#B29D34" />
    <SolidColorBrush x:Key="ThemeSheetDieNumber" Color="#0C0B0D" />
    <SolidColorBrush x:Key="ThemeSheetAccentText" Color="#B29D34" />
    <SolidColorBrush x:Key="ThemeSheetAccentBorder" Color="#B29D34" />
    <SolidColorBrush x:Key="ThemeSheetAccentHotbar" Color="#B29D34" />
    <SolidColorBrush x:Key="ThemeSheetHover" Color="#72171A" />
    <SolidColorBrush x:Key="ThemeSheetSelection" Color="#72171A" />
    <SolidColorBrush x:Key="ThemeSheetSelectionText" Color="#FBF7F4" />
    <SolidColorBrush x:Key="ThemeSheetScroll" Color="#B29D34" />
</ResourceDictionary>
