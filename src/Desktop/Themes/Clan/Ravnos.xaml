<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A aplicacao herda as cores da ficha; somente diferencas sao declaradas aqui. -->

    <!-- Cores da ficha e valores base compartilhados. -->
    <SolidColorBrush x:Key="ThemeSheetBackground" Color="#953939" />
    <SolidColorBrush x:Key="ThemeSheetOuterText" Color="#FFA82C" />
    <SolidColorBrush x:Key="ThemeSheetCard" Color="#5C251F" />
    <SolidColorBrush x:Key="ThemeSheetCardText" Color="#FFA82C" />
    <SolidColorBrush x:Key="ThemeSheetBorder" Color="#FFA82C" />
    <SolidColorBrush x:Key="ThemeSheetInput" Color="#5C251F" />
    <SolidColorBrush x:Key="ThemeSheetInputText" Color="#FFA82C" />
    <SolidColorBrush x:Key="ThemeSheetInputTitle" Color="#FFA82C" />
    <SolidColorBrush x:Key="ThemeSheetInputDescription" Color="#FFA82C" />
    <SolidColorBrush x:Key="ThemeSheetAccent" Color="#FFA82C" />
    <SolidColorBrush x:Key="ThemeSheetDieNumber" Color="#0C0B0D" />
    <SolidColorBrush x:Key="ThemeSheetAccentText" Color="#FFA82C" />
    <SolidColorBrush x:Key="ThemeSheetAccentBorder" Color="#C78F44" />
    <SolidColorBrush x:Key="ThemeSheetAccentHotbar" Color="#C78F44" />
    <SolidColorBrush x:Key="ThemeSheetHover" Color="#953939" />
    <SolidColorBrush x:Key="ThemeSheetSelection" Color="#953939" />
    <SolidColorBrush x:Key="ThemeSheetSelectionText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSheetScroll" Color="#C78F44" />
</ResourceDictionary>
