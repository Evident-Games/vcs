<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A aplicacao herda as cores da ficha; somente diferencas sao declaradas aqui. -->
    <SolidColorBrush x:Key="ThemeAppHeaderText" Color="#FCB0B3" />
    <SolidColorBrush x:Key="ThemeAppFooterText" Color="#FCB0B3" />

    <!-- Cores da ficha e valores base compartilhados. -->
    <SolidColorBrush x:Key="ThemeSheetBackground" Color="#445E93" />
    <SolidColorBrush x:Key="ThemeSheetOuterText" Color="#FFD806" />
    <SolidColorBrush x:Key="ThemeSheetCard" Color="#48649C" />
    <SolidColorBrush x:Key="ThemeSheetCardText" Color="#FFD806" />
    <SolidColorBrush x:Key="ThemeSheetBorder" Color="#FCB0B3" />
    <SolidColorBrush x:Key="ThemeSheetInput" Color="#445E93" />
    <SolidColorBrush x:Key="ThemeSheetInputText" Color="#FFD806" />
    <SolidColorBrush x:Key="ThemeSheetInputTitle" Color="#FFD806" />
    <SolidColorBrush x:Key="ThemeSheetInputDescription" Color="#FFD806" />
    <SolidColorBrush x:Key="ThemeSheetAccent" Color="#FFD806" />
    <SolidColorBrush x:Key="ThemeSheetDieNumber" Color="#0C0B0D" />
    <SolidColorBrush x:Key="ThemeSheetAccentText" Color="#FFD806" />
    <SolidColorBrush x:Key="ThemeSheetAccentBorder" Color="#FCB0B3" />
    <SolidColorBrush x:Key="ThemeSheetAccentHotbar" Color="#FCB0B3" />
    <SolidColorBrush x:Key="ThemeSheetHover" Color="#CE2F37" />
    <SolidColorBrush x:Key="ThemeSheetSelection" Color="#CE2F37" />
    <SolidColorBrush x:Key="ThemeSheetSelectionText" Color="#FFD806" />
    <SolidColorBrush x:Key="ThemeSheetScroll" Color="#CE2F37" />
</ResourceDictionary>
