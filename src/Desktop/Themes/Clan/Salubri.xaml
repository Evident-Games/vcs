<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A aplicacao herda as cores da ficha; somente diferencas sao declaradas aqui. -->
    <SolidColorBrush x:Key="ThemeAppHeaderText" Color="#E1FBFE" />
    <SolidColorBrush x:Key="ThemeAppFooterText" Color="#E1FBFE" />
    <SolidColorBrush x:Key="ThemeAppSelection" Color="#96A1CA" />

    <!-- Cores da ficha e valores base compartilhados. -->
    <SolidColorBrush x:Key="ThemeSheetBackground" Color="#96A1CA" />
    <SolidColorBrush x:Key="ThemeSheetOuterText" Color="#DB3456" />
    <SolidColorBrush x:Key="ThemeSheetCard" Color="#F0EEF1" />
    <SolidColorBrush x:Key="ThemeSheetCardText" Color="#DB3456" />
    <SolidColorBrush x:Key="ThemeSheetBorder" Color="#DB3456" />
    <SolidColorBrush x:Key="ThemeSheetInput" Color="#F0EEF1" />
    <SolidColorBrush x:Key="ThemeSheetInputText" Color="#DB3456" />
    <SolidColorBrush x:Key="ThemeSheetInputTitle" Color="#DB3456" />
    <SolidColorBrush x:Key="ThemeSheetInputDescription" Color="#DB3456" />
    <SolidColorBrush x:Key="ThemeSheetAccent" Color="#DB3456" />
    <SolidColorBrush x:Key="ThemeSheetDieNumber" Color="#0C0B0D" />
    <SolidColorBrush x:Key="ThemeSheetAccentText" Color="#DB3456" />
    <SolidColorBrush x:Key="ThemeSheetAccentBorder" Color="#DB3456" />
    <SolidColorBrush x:Key="ThemeSheetAccentHotbar" Color="#DB3456" />
    <SolidColorBrush x:Key="ThemeSheetHover" Color="#B7B1CF" />
    <SolidColorBrush x:Key="ThemeSheetSelection" Color="#F0EEF1" />
    <SolidColorBrush x:Key="ThemeSheetSelectionText" Color="#000000" />
    <SolidColorBrush x:Key="ThemeSheetScroll" Color="#B7B1CF" />
</ResourceDictionary>
