<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A aplicacao herda as cores da ficha; somente diferencas sao declaradas aqui. -->

    <!-- Cores da ficha e valores base compartilhados. -->
    <SolidColorBrush x:Key="ThemeSheetBackground" Color="#1C1A27" />
    <SolidColorBrush x:Key="ThemeSheetOuterText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="ThemeSheetCard" Color="#0D080C" />
    <SolidColorBrush x:Key="ThemeSheetCardText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="ThemeSheetBorder" Color="#292B36" />
    <SolidColorBrush x:Key="ThemeSheetInput" Color="#201A28" />
    <SolidColorBrush x:Key="ThemeSheetInputText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="ThemeSheetInputTitle" Color="#BAC4FF" />
    <SolidColorBrush x:Key="ThemeSheetInputDescription" Color="#BAC4FF" />
    <SolidColorBrush x:Key="ThemeSheetAccent" Color="#BAC4FF" />
    <SolidColorBrush x:Key="ThemeSheetDieNumber" Color="#0C0B0D" />
    <SolidColorBrush x:Key="ThemeSheetAccentText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="ThemeSheetAccentBorder" Color="#BAC4FF" />
    <SolidColorBrush x:Key="ThemeSheetAccentHotbar" Color="#BAC4FF" />
    <SolidColorBrush x:Key="ThemeSheetHover" Color="#19272A" />
    <SolidColorBrush x:Key="ThemeSheetSelection" Color="#19272A" />
    <SolidColorBrush x:Key="ThemeSheetSelectionText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="ThemeSheetScroll" Color="#BAC4FF" />
</ResourceDictionary>
