<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A aplicacao herda as cores da ficha; somente diferencas sao declaradas aqui. -->
    <SolidColorBrush x:Key="ThemeAppBackground" Color="#0C0C0C" />
    <SolidColorBrush x:Key="ThemeAppOuterText" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ThemeAppCard" Color="#191919" />
    <SolidColorBrush x:Key="ThemeAppCardText" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ThemeAppBorder" Color="#AAAAAA" />
    <SolidColorBrush x:Key="ThemeAppInput" Color="#000000" />
    <SolidColorBrush x:Key="ThemeAppInputText" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ThemeAppInputTitle" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ThemeAppInputDescription" Color="#D8D8D8" />
    <SolidColorBrush x:Key="ThemeAppAccent" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ThemeAppAccentText" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ThemeAppAccentBorder" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ThemeAppAccentHotbar" Color="#F2F2F2" />
    <SolidColorBrush x:Key="ThemeAppHover" Color="#0C0C0C" />
    <SolidColorBrush x:Key="ThemeAppSelection" Color="#151515" />
    <SolidColorBrush x:Key="ThemeAppSelectionText" Color="#FAFAFA" />
    <SolidColorBrush x:Key="ThemeAppScroll" Color="#D8D8D8" />

    <!-- Cores da ficha e valores base compartilhados. -->
    <!-- COPIAR DE CIMA ABAIXO -->
    <SolidColorBrush x:Key="ThemeSheetBackground" Color="#552961" />
    <SolidColorBrush x:Key="ThemeSheetOuterText" Color="#CCDAD0" />
    <SolidColorBrush x:Key="ThemeSheetCard" Color="#333333" />
    <SolidColorBrush x:Key="ThemeSheetCardText" Color="#CCDAD0" />
    <SolidColorBrush x:Key="ThemeSheetBorder" Color="#86A59C" />
    <SolidColorBrush x:Key="ThemeSheetInput" Color="#552961" />
    <SolidColorBrush x:Key="ThemeSheetInputText" Color="#CCDAD0" />
    <SolidColorBrush x:Key="ThemeSheetInputTitle" Color="#CCDAD0" />
    <SolidColorBrush x:Key="ThemeSheetInputDescription" Color="#CCDAD0" />
    <SolidColorBrush x:Key="ThemeSheetAccent" Color="#CCDAD0" />
    <SolidColorBrush x:Key="ThemeSheetDieNumber" Color="#0C0B0D" />
    <SolidColorBrush x:Key="ThemeSheetAccentText" Color="#CCDAD0" />
    <SolidColorBrush x:Key="ThemeSheetAccentBorder" Color="#86A59C" />
    <SolidColorBrush x:Key="ThemeSheetAccentHotbar" Color="#CCDAD0" />
    <SolidColorBrush x:Key="ThemeSheetHover" Color="#86A59C" />
    <SolidColorBrush x:Key="ThemeSheetSelection" Color="#86A59C" />
    <SolidColorBrush x:Key="ThemeSheetSelectionText" Color="#552961" />
    <SolidColorBrush x:Key="ThemeSheetScroll" Color="#545454" />
</ResourceDictionary>
