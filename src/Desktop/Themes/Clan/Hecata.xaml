<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A aplicacao herda as cores da ficha; somente diferencas sao declaradas aqui. -->

    <!-- Cores da ficha e valores base compartilhados. -->
    <SolidColorBrush x:Key="ThemeSheetBackground" Color="#424C55" />
    <SolidColorBrush x:Key="ThemeSheetOuterText" Color="#D1CCDC" />
    <SolidColorBrush x:Key="ThemeSheetCard" Color="#3D2C2E" />
    <SolidColorBrush x:Key="ThemeSheetCardText" Color="#F5EDF0" />
    <SolidColorBrush x:Key="ThemeSheetBorder" Color="#F5EDF0" />
    <SolidColorBrush x:Key="ThemeSheetInput" Color="#424C55" />
    <SolidColorBrush x:Key="ThemeSheetInputText" Color="#F5EDF0" />
    <SolidColorBrush x:Key="ThemeSheetInputTitle" Color="#F5EDF0" />
    <SolidColorBrush x:Key="ThemeSheetInputDescription" Color="#D1CCDC" />
    <SolidColorBrush x:Key="ThemeSheetAccent" Color="#F5EDF0" />
    <SolidColorBrush x:Key="ThemeSheetDieNumber" Color="#0C0B0D" />
    <SolidColorBrush x:Key="ThemeSheetAccentText" Color="#F5EDF0" />
    <SolidColorBrush x:Key="ThemeSheetAccentBorder" Color="#F5EDF0" />
    <SolidColorBrush x:Key="ThemeSheetAccentHotbar" Color="#F5EDF0" />
    <SolidColorBrush x:Key="ThemeSheetHover" Color="#D1CCDC" />
    <SolidColorBrush x:Key="ThemeSheetSelection" Color="#424C55" />
    <SolidColorBrush x:Key="ThemeSheetSelectionText" Color="#F5EDF0" />
    <SolidColorBrush x:Key="ThemeSheetScroll" Color="#D1CCDC" />
</ResourceDictionary>
