<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A aplicacao herda as cores da ficha; somente diferencas sao declaradas aqui. -->

    <!-- Cores da ficha e valores base compartilhados. -->
    <SolidColorBrush x:Key="ThemeSheetBackground" Color="#2E2F04" />
    <SolidColorBrush x:Key="ThemeSheetOuterText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSheetCard" Color="#442604" />
    <SolidColorBrush x:Key="ThemeSheetCardText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSheetBorder" Color="#D4A325" />
    <SolidColorBrush x:Key="ThemeSheetInput" Color="#333333" />
    <SolidColorBrush x:Key="ThemeSheetInputText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSheetInputTitle" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSheetInputDescription" Color="#D4A325" />
    <SolidColorBrush x:Key="ThemeSheetAccent" Color="#D4A325" />
    <SolidColorBrush x:Key="ThemeSheetDieNumber" Color="#0C0B0D" />
    <SolidColorBrush x:Key="ThemeSheetAccentText" Color="#D4A325" />
    <SolidColorBrush x:Key="ThemeSheetAccentBorder" Color="#D4A325" />
    <SolidColorBrush x:Key="ThemeSheetAccentHotbar" Color="#D4A325" />
    <SolidColorBrush x:Key="ThemeSheetHover" Color="#D4A325" />
    <SolidColorBrush x:Key="ThemeSheetSelection" Color="#2E2F04" />
    <SolidColorBrush x:Key="ThemeSheetSelectionText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSheetScroll" Color="#D4A325" />
</ResourceDictionary>
