<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A aplicacao herda as cores da ficha; somente diferencas sao declaradas aqui. -->

    <!-- Cores da ficha e valores base compartilhados. -->
    <SolidColorBrush x:Key="ThemeSheetBackground" Color="#FF7214" />
    <SolidColorBrush x:Key="ThemeSheetOuterText" Color="#333333" />
    <SolidColorBrush x:Key="ThemeSheetCard" Color="#FFB53D" />
    <SolidColorBrush x:Key="ThemeSheetCardText" Color="#333333" />
    <SolidColorBrush x:Key="ThemeSheetBorder" Color="#C30011" />
    <SolidColorBrush x:Key="ThemeSheetInput" Color="#333333" />
    <SolidColorBrush x:Key="ThemeSheetInputText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSheetInputTitle" Color="#333333" />
    <SolidColorBrush x:Key="ThemeSheetInputDescription" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSheetAccent" Color="#DB0013" />
    <SolidColorBrush x:Key="ThemeSheetDieNumber" Color="#FEF4E3" />
    <SolidColorBrush x:Key="ThemeSheetAccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThemeSheetAccentBorder" Color="#DB0013" />
    <SolidColorBrush x:Key="ThemeSheetAccentHotbar" Color="#DB0013" />
    <SolidColorBrush x:Key="ThemeSheetHover" Color="#DB0013" />
    <SolidColorBrush x:Key="ThemeSheetSelection" Color="#FF7214" />
    <SolidColorBrush x:Key="ThemeSheetSelectionText" Color="#333333" />
    <SolidColorBrush x:Key="ThemeSheetScroll" Color="#FF7214" />
</ResourceDictionary>
