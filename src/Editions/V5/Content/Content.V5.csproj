<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Namespace da camada e nome do assembly sao configurados separadamente. -->
    <AssemblyName>Content.V5</AssemblyName>
    <RootNamespace>Game.Content.V5</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\*.json" LogicalName="VCS.Content.Data.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
