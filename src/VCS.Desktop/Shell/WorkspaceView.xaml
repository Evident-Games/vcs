<UserControl x:Class="VCS.Desktop.Shell.WorkspaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sheet="clr-namespace:VCS.Desktop.Sheet"
    xmlns:shell="clr-namespace:VCS.Desktop.Shell"
    xmlns:themes="clr-namespace:VCS.Desktop.Themes">
    <!-- Open sheet tabs, the home view and every open sheet (alone or side by side). -->
    <DockPanel Margin="20,10,20,20">
    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding OpenEditors}" Margin="0,0,0,10"
                  Visibility="{Binding HasOpenEditors, Converter={StaticResource BoolVisibility}}"
                  AutomationProperties.Name="Fichas abertas">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border x:Name="Tab" Margin="0,0,6,4" CornerRadius="6" BorderThickness="1" Padding="10,2,2,2"
                        BorderBrush="{DynamicResource VcsBorder}" Background="{DynamicResource VcsCard}">
                    <StackPanel Orientation="Horizontal">
                        <Button Background="Transparent" BorderThickness="0" Padding="0,2" MaxWidth="180"
                                Command="{Binding DataContext.ActivateEditorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding TabTitle, StringFormat='Aba {0}'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="NPC" FontSize="10" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource VcsAccentText}"
                                           Visibility="{Binding IsNpc, Converter={StaticResource BoolVisibility}}" />
                                <TextBlock Text="{Binding TabTitle}" TextTrimming="CharacterEllipsis" FontFamily="Georgia"
                                           Foreground="{DynamicResource VcsCardText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Content="×" Width="22" Height="22" Padding="0" Margin="4,0,0,0" Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource VcsInputDescription}" ToolTip="Fechar ficha"
                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding TabTitle, StringFormat='Fechar {0}'}" />
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource VcsAccentBorder}" />
                        <Setter TargetName="Tab" Property="Background" Value="{DynamicResource VcsSelection}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid>
    <shell:HomeView Visibility="{Binding IsHome, Converter={StaticResource BoolVisibility}}" />
    <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolVisibility}}">
        <!-- One host for every open sheet: each sheet is built once, then shown alone or side by side.
             Switching sheets or turning bento on/off only changes visibility and columns. -->
        <ItemsControl ItemsSource="{Binding OpenEditors}" Focusable="False" Background="Transparent" AutomationProperties.Name="Fichas lado a lado">
            <ItemsControl.ContextMenu>
                <ContextMenu>
                    <themes:SheetThemeMenu />
                    <themes:AppThemeMenu />
                </ContextMenu>
            </ItemsControl.ContextMenu>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding DataContext.LayoutColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.IsSideBySide, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Alone, the sheet is a rounded surface in its own theme; side by side it becomes a card. -->
                    <Border x:Name="Pane" CornerRadius="12" themes:SheetTheme.Id="{Binding EffectiveSheetThemeId}"
                            Background="{DynamicResource VcsBackground}" BorderBrush="{DynamicResource VcsBorder}"
                            BorderThickness="1" Padding="18,14,8,12"
                            TextElement.Foreground="{DynamicResource VcsCardText}" PreviewMouseDown="OnSheetPaneMouseDown"
                            AutomationProperties.Name="{Binding TabTitle, StringFormat='Painel {0}'}">
                        <DockPanel>
                            <DockPanel x:Name="PaneHeader" DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="Collapsed">
                                <Button DockPanel.Dock="Right" Content="×" Width="22" Height="22" Padding="0" Background="Transparent"
                                        BorderThickness="0" Foreground="{DynamicResource VcsInputDescription}" ToolTip="Fechar ficha"
                                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding TabTitle, StringFormat='Fechar painel {0}'}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="11" Margin="0,0,8,0"
                                           Foreground="{DynamicResource VcsInputDescription}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TabTitle}" FontFamily="Georgia" FontSize="15" FontStyle="Italic"
                                           Foreground="{DynamicResource VcsAccentText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <sheet:CharacterEditorView x:Name="Sheet" />
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsSideBySide, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                            <Setter TargetName="Pane" Property="Margin" Value="4" />
                            <Setter TargetName="Pane" Property="CornerRadius" Value="8" />
                            <Setter TargetName="Pane" Property="Padding" Value="10,6,6,8" />
                            <Setter TargetName="Pane" Property="BorderThickness" Value="1" />
                            <Setter TargetName="Pane" Property="BorderBrush" Value="{DynamicResource VcsBorder}" />
                            <Setter TargetName="Pane" Property="Background" Value="{DynamicResource VcsCard}" />
                            <Setter TargetName="PaneHeader" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Sheet" Property="IsPane" Value="True" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding DataContext.IsSideBySide, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True" />
                                <Condition Binding="{Binding IsActive}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Pane" Property="BorderBrush" Value="{DynamicResource VcsAccentBorder}" />
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
    </Grid>
    </DockPanel>
</UserControl>
