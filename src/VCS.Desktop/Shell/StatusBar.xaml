<UserControl x:Class="VCS.Desktop.Shell.StatusBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Error, status message, update notice and busy indicator. -->
    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource VcsBorder}" Padding="24,10" TextElement.Foreground="{DynamicResource VcsFooterText}">
        <StackPanel>
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource VcsAccentText}" TextWrapping="Wrap" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Atualizar" Command="{Binding UpdateCommand}" Margin="12,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AvailableUpdate}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource VcsFooterText}" TextWrapping="Wrap" FontSize="12"
                           VerticalAlignment="Center" />
            </DockPanel>
            <ProgressBar Height="3" IsIndeterminate="True" Margin="0,6,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
    </Border>
</UserControl>
