<UserControl x:Class="VCS.Desktop.Shell.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Background="Transparent">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="36">
                <Border Width="44" Height="3" Background="{DynamicResource VcsAccent}" HorizontalAlignment="Center"
                        CornerRadius="2" Margin="0,0,0,20" />
                <TextBlock Text="Sua crônica começa aqui" FontFamily="Georgia" FontSize="30"
                           TextAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock Text="Escolha uma ficha na barra lateral para abrir seu espaço de jogo."
                           Margin="0,12,0,22" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource VcsInputDescription}" />
                <Button Content="Criar personagem" Command="{Binding CreateCommand}" HorizontalAlignment="Center"
                        MinWidth="170" AutomationProperties.Name="Criar personagem" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
