<UserControl x:Class="VCS.Desktop.Catalogs.AdvantageCatalogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:catalogs="clr-namespace:VCS.Desktop.Catalogs"
    xmlns:sheet="clr-namespace:VCS.Desktop.Sheet"
    xmlns:controls="clr-namespace:VCS.Desktop.Controls">
    <UserControl.Resources>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ColumnHead" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource VcsInputDescription}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style x:Key="Guidance" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource VcsInputDescription}" />
            <Style.Triggers>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Empty" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource VcsInputDescription}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WarningMark" TargetType="Border">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="{DynamicResource VcsInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VcsAccentBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="ToolTip" Value="{Binding Warning}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="Visibility" Value="{Binding HasWarning, Converter={StaticResource BoolVisibility}}" />
        </Style>

        <Style x:Key="EditableOnly" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFixed}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FixedOnly" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="{Binding IsFixed, Converter={StaticResource BoolVisibility}}" />
        </Style>
        <!-- Predator lines get a thin accent bar outside the columns, so the grid stays aligned. -->
        <Style x:Key="RowFrame" TargetType="Border">
            <Setter Property="Margin" Value="-8,0,0,0" />
            <Setter Property="Padding" Value="6,0,0,0" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPredator}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource VcsAccentBorder}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FixedName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPredator}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource VcsAccentText}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPending}" Value="True">
                    <Setter Property="FontWeight" Value="Normal" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Subtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource VcsInputDescription}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Subtitle}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="MeritRow" DataType="{x:Type sheet:MeritRowViewModel}">
            <StackPanel Margin="0,0,0,6">
                <Border Style="{StaticResource RowFrame}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="62" />
                    </Grid.ColumnDefinitions>
                    <controls:SuggestionBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Suggestions="{Binding CategorySuggestions}"
                                            Placeholder="categoria" EditorName="Categoria da caracteristica" IsEnabled="{Binding CanEditCategory}"
                                            Style="{StaticResource EditableOnly}" Margin="0,0,10,0" VerticalAlignment="Bottom" />
                    <TextBlock Text="{Binding Category}" Style="{StaticResource FixedOnly}" FontSize="12" FontStyle="Italic"
                               Foreground="{DynamicResource VcsInputDescription}" TextTrimming="CharacterEllipsis" Margin="0,0,10,4" VerticalAlignment="Bottom" />
                    <controls:SuggestionBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Suggestions="{Binding NameSuggestions}"
                                            Placeholder="escolha ou escreva" EditorName="Nome da caracteristica" IsEnabled="{Binding CanEditName}"
                                            Style="{StaticResource EditableOnly}" ToolTip="{Binding Reference}" Margin="0,0,10,0" VerticalAlignment="Bottom" />
                    <StackPanel Grid.Column="1" Style="{StaticResource FixedOnly}" Margin="0,0,10,2" VerticalAlignment="Bottom"
                                ToolTip="{Binding Reference}" AutomationProperties.Name="{Binding Name}">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource FixedName}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtitle}" AutomationProperties.Name="Origem da caracteristica" />
                    </StackPanel>
                    <controls:DotTrack Grid.Column="2" Value="{Binding Rating, Mode=TwoWay}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                       IsEnabled="{Binding CanEditRating}" VerticalAlignment="Bottom" AutomationProperties.Name="Pontos da caracteristica">
                        <controls:DotTrack.LayoutTransform><ScaleTransform ScaleX="0.78" ScaleY="0.78" /></controls:DotTrack.LayoutTransform>
                    </controls:DotTrack>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <Border Style="{StaticResource WarningMark}">
                            <TextBlock Text="!" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource VcsAccentText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button Command="{Binding ToggleDetailsCommand}" Margin="0,0,4,0" ToolTip="Referência e anotações"
                                AutomationProperties.Name="Extras da caracteristica">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RoundIconButton}">
                                    <Setter Property="Content" Value="▸" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="Content" Value="▾" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource RoundIconButton}" Content="×" Command="{Binding RemoveCommand}" ToolTip="Remover linha"
                                AutomationProperties.Name="Remover caracteristica" />
                    </StackPanel>
                </Grid>
                </Border>
                <Border Margin="190,6,62,4" Padding="12,6,6,8" BorderThickness="2,0,0,0" BorderBrush="{DynamicResource VcsBorder}"
                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Reference}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource VcsInputDescription}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource PaperLineTextBox}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Tag="anotações"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxLength="20000" FontSize="12.5"
                                 IsReadOnly="{Binding IsLocked}"
                                 AutomationProperties.Name="Anotacoes da caracteristica" />
                        <TextBlock Text="{Binding Warning}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource VcsAccentText}"
                                   Visibility="{Binding HasWarning, Converter={StaticResource BoolVisibility}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <Grid x:Key="Heads" x:Shared="False" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="62" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Categoria" Style="{StaticResource ColumnHead}" />
            <TextBlock Grid.Column="1" Text="Nome" Style="{StaticResource ColumnHead}" />
            <TextBlock Grid.Column="2" Text="Pontos" Style="{StaticResource ColumnHead}" />
        </Grid>
    </UserControl.Resources>
    <StackPanel Margin="8,0">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Vantagens" Style="{StaticResource GroupTitle}" />
            <Button Style="{StaticResource RoundIconButton}" Content="+" Command="{Binding AddAdvantageRowCommand}" Margin="8,0,0,0"
                    ToolTip="Adicionar vantagem" AutomationProperties.Name="Adicionar vantagem" />
        </StackPanel>
        <TextBlock Style="{StaticResource Guidance}"
                   Text="{Binding Tag.AdvantageSelectionGuidance, RelativeSource={RelativeSource AncestorType={x:Type catalogs:AdvantageCatalogView}}}" />
        <ContentControl Content="{StaticResource Heads}" Focusable="False" />
        <ItemsControl ItemsSource="{Binding AdvantageRows}" ItemTemplate="{StaticResource MeritRow}" AutomationProperties.Name="Vantagens da ficha" />
        <TextBlock Text="Nenhuma vantagem. Use + para adicionar uma linha; navegue pela categoria ou escreva o nome."
                   Style="{StaticResource Empty}" Tag="{Binding AdvantageRows.Count}" />

        <StackPanel Orientation="Horizontal" Margin="0,22,0,4">
            <TextBlock Text="Defeitos" Style="{StaticResource GroupTitle}" />
            <Button Style="{StaticResource RoundIconButton}" Content="+" Command="{Binding AddFlawRowCommand}" Margin="8,0,0,0"
                    ToolTip="Adicionar defeito" AutomationProperties.Name="Adicionar defeito" />
        </StackPanel>
        <TextBlock Style="{StaticResource Guidance}"
                   Text="{Binding Tag.FlawSelectionGuidance, RelativeSource={RelativeSource AncestorType={x:Type catalogs:AdvantageCatalogView}}}" />
        <ContentControl Content="{StaticResource Heads}" Focusable="False" />
        <ItemsControl ItemsSource="{Binding FlawRows}" ItemTemplate="{StaticResource MeritRow}" AutomationProperties.Name="Defeitos da ficha" />
        <TextBlock Text="Nenhum defeito. Use + para adicionar uma linha." Style="{StaticResource Empty}" Tag="{Binding FlawRows.Count}" />
    </StackPanel>
</UserControl>
