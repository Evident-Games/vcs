<UserControl x:Class="VCS.Desktop.Sheet.SheetSectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VCS.Desktop.Controls"
    xmlns:catalogs="clr-namespace:VCS.Desktop.Catalogs"
    xmlns:sheet="clr-namespace:VCS.Desktop.Sheet">
    <UserControl.Resources>
        <!-- Body templates are keyed by section key; SheetSectionView.xaml.cs picks one. -->
        <DataTemplate x:Key="Identity"><sheet:IdentitySheetView /></DataTemplate>
        <DataTemplate x:Key="NpcHeader"><sheet:NpcQuickSheetView Part="NpcHeader" /></DataTemplate>
        <DataTemplate x:Key="NpcCombat"><sheet:NpcQuickSheetView Part="NpcCombat" /></DataTemplate>
        <DataTemplate x:Key="NpcAttributes"><sheet:NpcQuickSheetView Part="NpcAttributes" /></DataTemplate>
        <DataTemplate x:Key="NpcSkills"><sheet:NpcQuickSheetView Part="NpcSkills" /></DataTemplate>
        <DataTemplate x:Key="NpcDisciplines"><sheet:NpcQuickSheetView Part="NpcDisciplines" /></DataTemplate>
        <DataTemplate x:Key="NpcAdvantages"><sheet:NpcQuickSheetView Part="NpcAdvantages" /></DataTemplate>
        <DataTemplate x:Key="NpcHistory"><sheet:NpcQuickSheetView Part="NpcHistory" /></DataTemplate>
        <DataTemplate x:Key="AttributeRow">
            <StackPanel Margin="0,6">
                <TextBlock Text="{Binding Name}" FontSize="13" />
                <controls:DotTrack x:Name="Track" Value="{Binding Rating, Mode=TwoWay}" AutomationProperties.Name="{Binding Key}" />
                <!-- Two fixed lines as wide as the dots, so the cost text never widens the column. -->
                <TextBlock Text="{Binding AdvancementInfo}" FontSize="10" Opacity="0.75" Foreground="{DynamicResource VcsInputDescription}"
                           Width="{Binding ActualWidth, ElementName=Track}" Height="28" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding AdvancementInfo}"
                           AutomationProperties.Name="{Binding Name, StringFormat=Custo de {0}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Attributes">
            <StackPanel>
            <DockPanel Margin="8,0,8,12">
                <StackPanel>
                    <TextBlock Text="{Binding AttributesSummary}" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource VcsAccentText}" AutomationProperties.Name="Atributos que faltam" />
                    <TextBlock Text="{Binding InitialAttributesDescription}" TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                               Margin="0,2,0,0" Foreground="{DynamicResource VcsInputDescription}"
                               AutomationProperties.Name="Distribuicao inicial de atributos" />
                </StackPanel>
            </DockPanel>
            <UniformGrid Columns="3" IsEnabled="{Binding CanEditBuild}">
                <StackPanel Margin="8">
                    <TextBlock Text="Fisicos" HorizontalAlignment="Center" FontFamily="Georgia" FontStyle="Italic" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding PhysicalAttributes}" ItemTemplate="{StaticResource AttributeRow}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Margin="8">
                    <TextBlock Text="Sociais" HorizontalAlignment="Center" FontFamily="Georgia" FontStyle="Italic" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding SocialAttributes}" ItemTemplate="{StaticResource AttributeRow}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Margin="8">
                    <TextBlock Text="Mentais" HorizontalAlignment="Center" FontFamily="Georgia" FontStyle="Italic" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding MentalAttributes}" ItemTemplate="{StaticResource AttributeRow}" HorizontalAlignment="Center" />
                </StackPanel>
            </UniformGrid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Skills">
            <sheet:SkillsView />
        </DataTemplate>
        <DataTemplate x:Key="Disciplines">
            <catalogs:DisciplineCatalogView />
        </DataTemplate>
        <DataTemplate x:Key="Advantages">
            <StackPanel>
                <sheet:PredatorView />
                <StackPanel IsEnabled="{Binding CanEditBuild}">
                    <catalogs:AdvantageCatalogView DataContext="{Binding AdvantageCatalog}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=FrameworkElement}}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="State">
            <StackPanel>
                <UniformGrid Columns="2" Margin="0,0,0,20">
                    <StackPanel Margin="8">
                        <TextBlock Text="Saude" Style="{StaticResource SectionTitle}" />
                        <controls:DamageTrack Capacity="{Binding HealthCapacity}" Superficial="{Binding HealthSuperficial, Mode=TwoWay}"
                                              Aggravated="{Binding HealthAggravated, Mode=TwoWay}" AutomationProperties.Name="Saude na ficha" />
                    </StackPanel>
                    <StackPanel Margin="8">
                        <TextBlock Text="Forca de Vontade" Style="{StaticResource SectionTitle}" />
                        <controls:DamageTrack Capacity="{Binding WillpowerCapacity}" Superficial="{Binding WillpowerSuperficial, Mode=TwoWay}"
                                              Aggravated="{Binding WillpowerAggravated, Mode=TwoWay}" AutomationProperties.Name="Vontade na ficha" />
                    </StackPanel>
                </UniformGrid>
                <WrapPanel>
                    <StackPanel Margin="8,0,24,16">
                        <TextBlock Text="Fome" Style="{StaticResource FieldLabel}" />
                        <controls:DotTrack Value="{Binding Hunger, Mode=TwoWay}" Maximum="5" AutomationProperties.Name="Fome na ficha" />
                    </StackPanel>
                    <StackPanel Margin="8,0,24,16">
                        <TextBlock Text="Humanidade" Style="{StaticResource FieldLabel}" />
                        <controls:DotTrack Value="{Binding Humanity, Mode=TwoWay}" Maximum="10" AutomationProperties.Name="Humanidade na ficha" />
                    </StackPanel>
                    <StackPanel Margin="8,0,0,16">
                        <TextBlock Text="Potencia de Sangue" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding StateExperience}" TextWrapping="Wrap" Foreground="{DynamicResource VcsAccentText}" />
                        <controls:DotTrack Value="{Binding BloodPotency, Mode=TwoWay}" Maximum="10"
                                           IsEnabled="{Binding CanEditBuild}"
                                           AutomationProperties.Name="Potencia de sangue na ficha" />
                    </StackPanel>
                </WrapPanel>
                <sheet:HumanityView />
                <TextBlock Text="Sangue: valores de referencia preenchidos pela mesa; sem calculo automatico." TextWrapping="Wrap"
                           Foreground="{DynamicResource VcsInputDescription}" Margin="8" />
                <ItemsControl ItemsSource="{Binding BloodFields}" ItemTemplate="{StaticResource SheetExtraField}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Background">
            <StackPanel>
                <sheet:AdvancementView />
                <ItemsControl ItemsSource="{Binding BackgroundFields}" ItemTemplate="{StaticResource SheetExtraField}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="Descrição" Style="{StaticResource FieldLabel}" Margin="8,12,8,4" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="80" MaxHeight="240" MaxLength="20000"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Descricao do personagem" />
            </StackPanel>
        </DataTemplate>
        <!-- Notes: searchable list of titled notes on the left, the selected note on the right. -->
        <DataTemplate x:Key="Notes">
            <Grid DataContext="{Binding Notebook}" MinHeight="340">
                <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <DockPanel Margin="0,0,14,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="+ Nova nota" Command="{Binding AddCommand}" Margin="8,0,0,0"
                                AutomationProperties.Name="Nova nota" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PaperLineTextBox}"
                                 Tag="Buscar notas" AutomationProperties.Name="Buscar notas" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding VisibleNotes}" SelectedItem="{Binding SelectedNote}" MaxHeight="520"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Lista de notas">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Preview}" FontSize="11" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                                    <TextBlock Text="{Binding DateLabel}" FontSize="10" Foreground="{DynamicResource VcsInputDescription}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <DockPanel Grid.Column="1" DataContext="{Binding SelectedNote}">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Excluir" Margin="8,0,0,0" ToolTip="Excluir esta nota"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Grid}}"
                                CommandParameter="{Binding}" AutomationProperties.Name="Excluir nota" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DateLabel}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource VcsInputDescription}" />
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" FontFamily="Georgia" FontSize="17"
                                 Style="{StaticResource PaperLineTextBox}" Tag="Titulo da nota" Margin="0,0,12,0"
                                 AutomationProperties.Name="Titulo da nota" />
                    </DockPanel>
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap" VerticalContentAlignment="Top" MinHeight="300" MaxHeight="560"
                             VerticalScrollBarVisibility="Auto" MaxLength="100000" Padding="10,8"
                             AutomationProperties.Name="Texto da nota" />
                </DockPanel>
                <TextBlock Grid.Column="1" Text="Nenhuma nota ainda. Use + Nova nota para comecar." TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource VcsInputDescription}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNotes}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource VcsBorder}" />
                <Setter Property="Background" Value="{DynamicResource VcsCard}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource VcsCardText}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="MaxWidth" Value="1100" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=sheet:SheetSectionView}}" Value="True">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MaxWidth" Value="Infinity" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <TextBlock Text="{Binding Option.DisplayTitle}" FontFamily="Georgia" FontSize="22" HorizontalAlignment="Center"
                       Foreground="{DynamicResource VcsAccentText}" Margin="0,0,0,16">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=sheet:SheetSectionView}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <!-- The NPC header shows its own heading. -->
                            <DataTrigger Binding="{Binding Key}" Value="NpcHeader"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ContentControl x:Name="Body" Focusable="False" />
        </StackPanel>
    </Border>
</UserControl>
