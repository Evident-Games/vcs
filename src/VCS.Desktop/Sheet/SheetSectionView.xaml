<UserControl x:Class="VCS.Desktop.Sheet.SheetSectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VCS.Desktop.Controls"
    xmlns:catalogs="clr-namespace:VCS.Desktop.Catalogs"
    xmlns:sheet="clr-namespace:VCS.Desktop.Sheet">
    <UserControl.Resources>
        <!-- Body templates are keyed by section key; SheetSectionView.xaml.cs picks one. -->
        <DataTemplate x:Key="Identity"><sheet:IdentitySheetView /></DataTemplate>
        <DataTemplate x:Key="NpcHeader"><sheet:NpcQuickSheetView Part="NpcHeader" /></DataTemplate>
        <DataTemplate x:Key="NpcCombat"><sheet:NpcQuickSheetView Part="NpcCombat" /></DataTemplate>
        <DataTemplate x:Key="NpcAttributes"><sheet:NpcQuickSheetView Part="NpcAttributes" /></DataTemplate>
        <DataTemplate x:Key="NpcSkills"><sheet:NpcQuickSheetView Part="NpcSkills" /></DataTemplate>
        <DataTemplate x:Key="NpcDisciplines"><sheet:NpcQuickSheetView Part="NpcDisciplines" /></DataTemplate>
        <DataTemplate x:Key="NpcAdvantages"><sheet:NpcQuickSheetView Part="NpcAdvantages" /></DataTemplate>
        <DataTemplate x:Key="NpcHistory"><sheet:NpcQuickSheetView Part="NpcHistory" /></DataTemplate>
        <DataTemplate x:Key="AttributeRow">
            <StackPanel Margin="0,6">
                <TextBlock Text="{Binding Name}" FontSize="13" />
                <controls:DotTrack x:Name="Track" Value="{Binding Rating, Mode=TwoWay}" AutomationProperties.Name="{Binding Key}" />
                <!-- Two fixed lines as wide as the dots, so the cost text never widens the column. -->
                <TextBlock Text="{Binding AdvancementInfo}" FontSize="10" Opacity="0.75" Foreground="{DynamicResource VcsInputDescription}"
                           Width="{Binding ActualWidth, ElementName=Track}" Height="28" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding AdvancementInfo}"
                           AutomationProperties.Name="{Binding Name, StringFormat=Custo de {0}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Attributes">
            <StackPanel>
            <DockPanel Margin="8,0,8,12">
                <StackPanel>
                    <TextBlock Text="{Binding AttributesSummary}" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource VcsAccentText}" AutomationProperties.Name="Atributos que faltam" />
                    <TextBlock Text="{Binding InitialAttributesDescription}" TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                               Margin="0,2,0,0" Foreground="{DynamicResource VcsInputDescription}"
                               AutomationProperties.Name="Distribuicao inicial de atributos" />
                </StackPanel>
            </DockPanel>
            <UniformGrid Columns="3" IsEnabled="{Binding CanEditBuild}">
                <StackPanel Margin="8">
                    <TextBlock Text="Fisicos" HorizontalAlignment="Center" FontFamily="Georgia" FontStyle="Italic" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding PhysicalAttributes}" ItemTemplate="{StaticResource AttributeRow}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Margin="8">
                    <TextBlock Text="Sociais" HorizontalAlignment="Center" FontFamily="Georgia" FontStyle="Italic" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding SocialAttributes}" ItemTemplate="{StaticResource AttributeRow}" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Margin="8">
                    <TextBlock Text="Mentais" HorizontalAlignment="Center" FontFamily="Georgia" FontStyle="Italic" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding MentalAttributes}" ItemTemplate="{StaticResource AttributeRow}" HorizontalAlignment="Center" />
                </StackPanel>
            </UniformGrid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Skills">
            <sheet:SkillsView />
        </DataTemplate>
        <DataTemplate x:Key="Disciplines">
            <catalogs:DisciplineCatalogView />
        </DataTemplate>
        <DataTemplate x:Key="Advantages">
            <StackPanel>
                <sheet:PredatorView />
                <StackPanel IsEnabled="{Binding CanEditBuild}">
                    <catalogs:AdvantageCatalogView DataContext="{Binding AdvantageCatalog}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=FrameworkElement}}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="State">
            <StackPanel>
                <UniformGrid Columns="2" Margin="0,0,0,20">
                    <StackPanel Margin="8">
                        <TextBlock Text="Saude" Style="{StaticResource SectionTitle}" />
                        <controls:DamageTrack Capacity="{Binding HealthCapacity}" Superficial="{Binding HealthSuperficial, Mode=TwoWay}"
                                              Aggravated="{Binding HealthAggravated, Mode=TwoWay}" AutomationProperties.Name="Saude na ficha" />
                    </StackPanel>
                    <StackPanel Margin="8">
                        <TextBlock Text="Forca de Vontade" Style="{StaticResource SectionTitle}" />
                        <controls:DamageTrack Capacity="{Binding WillpowerCapacity}" Superficial="{Binding WillpowerSuperficial, Mode=TwoWay}"
                                              Aggravated="{Binding WillpowerAggravated, Mode=TwoWay}" AutomationProperties.Name="Vontade na ficha" />
                    </StackPanel>
                </UniformGrid>
                <WrapPanel>
                    <StackPanel Margin="8,0,24,16">
                        <TextBlock Text="Fome" Style="{StaticResource FieldLabel}" />
                        <controls:DotTrack Value="{Binding Hunger, Mode=TwoWay}" Maximum="5" AutomationProperties.Name="Fome na ficha" />
                        <Button Content="Fazer checagem de Sangue" Command="{Binding MakeRouseCheckCommand}" Margin="0,6,0,0"
                                AutomationProperties.Name="Fazer checagem de Sangue" />
                        <TextBlock Text="{Binding RouseRuleSource, StringFormat=Fonte: {0}}" FontSize="10" Foreground="{DynamicResource VcsInputDescription}" />
                        <TextBlock Text="{Binding RouseCheckSummary}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource VcsInputDescription}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Margin="8,0,24,16">
                        <TextBlock Text="Humanidade" Style="{StaticResource FieldLabel}" />
                        <controls:DotTrack Value="{Binding Humanity, Mode=TwoWay}" Maximum="10" AutomationProperties.Name="Humanidade na ficha" />
                    </StackPanel>
                </WrapPanel>
                <Border Visibility="{Binding HasBloodPotencyRuleWarning, Converter={StaticResource BoolVisibility}}"
                        BorderBrush="{DynamicResource VcsAccentBorder}" Background="{DynamicResource VcsInput}"
                        BorderThickness="1" CornerRadius="7" Padding="10" Margin="8,0,8,10">
                    <StackPanel>
                        <TextBlock Text="Aviso de regra" FontWeight="SemiBold" Foreground="{DynamicResource VcsAccentText}" />
                        <TextBlock Text="{Binding BloodPotencyRuleWarning}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Foreground="{DynamicResource VcsCardText}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding GenerationRuleSource, StringFormat=Fonte: {0}}" FontSize="10" Margin="8,0,8,4" Foreground="{DynamicResource VcsInputDescription}" />
                <sheet:BloodLineageDiagram BloodPotency="{Binding BloodPotency, Mode=TwoWay}"
                                             Generation="{Binding Generation, Mode=TwoWay}"
                                             BloodPotencyEnabled="{Binding CanEditBuild}" Margin="8,0,8,12" />
                <Border Background="{DynamicResource VcsBackground}" BorderBrush="{DynamicResource VcsBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="8,0,8,12">
                    <StackPanel>
                        <TextBlock Text="Rolagem de dados V5" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="Dados na parada" Style="{StaticResource FieldLabel}" />
                                <controls:NumericField Value="{Binding RollDicePool, Mode=TwoWay}" Minimum="0" Maximum="50"
                                                       AutomationProperties.Name="Dados na parada" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="Dificuldade" Style="{StaticResource FieldLabel}" />
                                <controls:NumericField Value="{Binding RollDifficulty, Mode=TwoWay}" Minimum="0" Maximum="50"
                                                       AutomationProperties.Name="Dificuldade do teste" />
                            </StackPanel>
                            <CheckBox Content="Usar dados de Fome" IsChecked="{Binding UseHungerDice, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,12,6" />
                            <CheckBox Content="Usar Surto de Sangue" IsChecked="{Binding UseBloodSurge, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,12,6" />
                            <Button Content="Rolar teste" Command="{Binding RollTestCommand}" Margin="0,0,0,6"
                                    AutomationProperties.Name="Rolar teste V5" />
                        </WrapPanel>
                        <TextBlock Text="{Binding RollSummary}" TextWrapping="Wrap" Foreground="{DynamicResource VcsInputDescription}" />
                        
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource VcsBackground}" BorderBrush="{DynamicResource VcsBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="8,0,8,12">
                    <StackPanel>
                        <TextBlock Text="Resistência ao Frenesi" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Margin="0,0,12,6" MinWidth="260">
                                <TextBlock Text="Gatilho" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding FrenzyTriggerOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedFrenzyTriggerOption, Mode=TwoWay}"
                                          AutomationProperties.Name="Gatilho de Frenesi" />
                            </StackPanel>
                            <CheckBox Content="Pilar ou amante" IsChecked="{Binding FrenzyTriggerIsPillarOrLover, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,12,6" />
                            <Button Content="Testar resistência" Command="{Binding ResistFrenzyCommand}" Margin="0,0,0,6"
                                    AutomationProperties.Name="Testar resistência ao Frenesi" />
                        </WrapPanel>
                        <TextBlock Text="{Binding FrenzyTriggerGuidance}" TextWrapping="Wrap" Foreground="{DynamicResource VcsInputDescription}" />
                        <TextBlock Text="{Binding FrenzySummary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource VcsBackground}" BorderBrush="{DynamicResource VcsBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="8,0,8,12">
                    <StackPanel>
                        <TextBlock Text="Alimentação" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Margin="0,0,12,6" MinWidth="220">
                                <TextBlock Text="Fonte de sangue" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding BloodSourceOptions}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedBloodSourceOption, Mode=TwoWay}"
                                          AutomationProperties.Name="Fonte de sangue" />
                            </StackPanel>
                            <CheckBox Content="Animal grande" IsChecked="{Binding FeedingAnimalIsLarge, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,12,6" />
                            <CheckBox Content="Animal excepcional" IsChecked="{Binding FeedingAnimalIsExceptional, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,12,6" />
                            <CheckBox Content="Humano drenado até a morte" IsChecked="{Binding FeedingHumanWasDrained, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="0,0,12,6" />
                            <Button Content="Aplicar alimentação" Command="{Binding ApplyFeedingCommand}" Margin="0,0,0,6"
                                    AutomationProperties.Name="Aplicar alimentação" />
                        </WrapPanel>
                        <TextBlock Text="{Binding FeedingRuleSource, StringFormat=Fonte: {0}}" FontSize="10" Foreground="{DynamicResource VcsInputDescription}" />
                        <TextBlock Text="{Binding FeedingPreview}" TextWrapping="Wrap" Foreground="{DynamicResource VcsInputDescription}" />
                        <TextBlock Text="{Binding FeedingSummary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <UniformGrid Columns="3" Margin="8,0,8,12">
                    <Border Background="{DynamicResource VcsCard}" BorderBrush="{DynamicResource VcsBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,6">
                        <StackPanel><TextBlock Text="Surto de Sangue" Foreground="{DynamicResource VcsInputDescription}" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BloodSurgeSummary}" FontWeight="SemiBold" Foreground="{DynamicResource VcsAccentText}" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                    <Border Background="{DynamicResource VcsCard}" BorderBrush="{DynamicResource VcsBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="3,0,3,6">
                        <StackPanel><TextBlock Text="Recuperação superficial" Foreground="{DynamicResource VcsInputDescription}" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BloodMendSummary}" FontWeight="SemiBold" Foreground="{DynamicResource VcsAccentText}" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                    <Border Background="{DynamicResource VcsCard}" BorderBrush="{DynamicResource VcsBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,6">
                        <StackPanel><TextBlock Text="Bônus em poderes" Foreground="{DynamicResource VcsInputDescription}" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BloodPowerBonusSummary}" FontWeight="SemiBold" Foreground="{DynamicResource VcsAccentText}" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                    <Border Background="{DynamicResource VcsCard}" BorderBrush="{DynamicResource VcsBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                        <StackPanel><TextBlock Text="Rerrolagem de despertar" Foreground="{DynamicResource VcsInputDescription}" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BloodRouseRerollSummary}" FontWeight="SemiBold" Foreground="{DynamicResource VcsAccentText}" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                    <Border Background="{DynamicResource VcsCard}" BorderBrush="{DynamicResource VcsBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="3,0,3,0">
                        <StackPanel><TextBlock Text="Gravidade da Perdição" Foreground="{DynamicResource VcsInputDescription}" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BloodBaneSeveritySummary}" FontWeight="SemiBold" Foreground="{DynamicResource VcsAccentText}" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                    <Border Background="{DynamicResource VcsCard}" BorderBrush="{DynamicResource VcsBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                        <StackPanel><TextBlock Text="Alimentação" Foreground="{DynamicResource VcsInputDescription}" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BloodFeedingPenaltySummary}" FontWeight="SemiBold" Foreground="{DynamicResource VcsAccentText}" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                </UniformGrid>
                <sheet:HumanityView />
                <TextBlock Text="Ressonância e Discrasia são registradas pela mesa. Os demais efeitos são calculados pela Potência do Sangue; confirme exceções com o Narrador."
                           TextWrapping="Wrap" Foreground="{DynamicResource VcsInputDescription}" Margin="8,0,8,4" />
                <ItemsControl ItemsSource="{Binding BloodAnnotationFields}" ItemTemplate="{StaticResource SheetExtraField}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Background">
            <StackPanel>
                <sheet:AdvancementView />
                <ItemsControl ItemsSource="{Binding BackgroundFields}" ItemTemplate="{StaticResource SheetExtraField}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="Descrição" Style="{StaticResource FieldLabel}" Margin="8,12,8,4" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="80" MaxHeight="240" MaxLength="20000"
                         VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Descricao do personagem" />
            </StackPanel>
        </DataTemplate>
        <!-- Notes: searchable list of titled notes on the left, the selected note on the right. -->
        <DataTemplate x:Key="Notes">
            <Grid DataContext="{Binding Notebook}" MinHeight="340">
                <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <DockPanel Margin="0,0,14,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="+ Nova nota" Command="{Binding AddCommand}" Margin="8,0,0,0"
                                AutomationProperties.Name="Nova nota" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PaperLineTextBox}"
                                 Tag="Buscar notas" AutomationProperties.Name="Buscar notas" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding VisibleNotes}" SelectedItem="{Binding SelectedNote}" MaxHeight="520"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Lista de notas">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,3">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Preview}" FontSize="11" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                                    <TextBlock Text="{Binding DateLabel}" FontSize="10" Foreground="{DynamicResource VcsInputDescription}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <DockPanel Grid.Column="1" DataContext="{Binding SelectedNote}">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Excluir" Margin="8,0,0,0" ToolTip="Excluir esta nota"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Grid}}"
                                CommandParameter="{Binding}" AutomationProperties.Name="Excluir nota" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding DateLabel}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource VcsInputDescription}" />
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" FontFamily="Georgia" FontSize="17"
                                 Style="{StaticResource PaperLineTextBox}" Tag="Titulo da nota" Margin="0,0,12,0"
                                 AutomationProperties.Name="Titulo da nota" />
                    </DockPanel>
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap" VerticalContentAlignment="Top" MinHeight="300" MaxHeight="560"
                             VerticalScrollBarVisibility="Auto" MaxLength="100000" Padding="10,8"
                             AutomationProperties.Name="Texto da nota" />
                </DockPanel>
                <TextBlock Grid.Column="1" Text="Nenhuma nota ainda. Use + Nova nota para comecar." TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource VcsInputDescription}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNotes}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource VcsBorder}" />
                <Setter Property="Background" Value="{DynamicResource VcsCard}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource VcsCardText}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="MaxWidth" Value="1100" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=sheet:SheetSectionView}}" Value="True">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MaxWidth" Value="Infinity" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Expander IsExpanded="True" BorderThickness="0" Background="Transparent" Padding="0"
                  AutomationProperties.Name="{Binding Option.DisplayTitle}" AutomationProperties.HelpText="Expandir ou recolher esta seção">
            <Expander.Header>
                <Grid Margin="0,0,0,12">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=sheet:SheetSectionView}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <!-- The NPC header shows its own heading. -->
                                <DataTrigger Binding="{Binding Key}" Value="NpcHeader">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource VcsAccent}" CornerRadius="2" Margin="0,2,12,2" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Option.DisplayTitle}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource VcsAccentText}" TextTrimming="CharacterEllipsis" />
                        <Border Height="1" Background="{DynamicResource VcsBorder}" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Expander.Header>
            <ContentControl x:Name="Body" Focusable="False" />
        </Expander>
    </Border>
</UserControl>
