<UserControl x:Class="VCS.Desktop.Sheet.SkillsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VCS.Desktop.Controls"
    xmlns:sheet="clr-namespace:VCS.Desktop.Sheet">
    <UserControl.Resources>
        <Style x:Key="SkillHelp" TargetType="Border">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource VcsInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource VcsBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource VcsAccentBorder}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SkillHelpMark" TargetType="TextBlock">
            <Setter Property="Text" Value="?" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource VcsAccentText}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SkillStat" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource VcsInputDescription}" />
        </Style>
        <DataTemplate DataType="{x:Type sheet:TraitItemViewModel}">
            <StackPanel Margin="0,0,0,10">
                <DockPanel>
                    <controls:DotTrack DockPanel.Dock="Right" Value="{Binding Rating, Mode=TwoWay}"
                                       AutomationProperties.Name="{Binding Name, StringFormat='Pontos de {0}'}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource PredatorTag}" Margin="6,0,8,0"
                            Command="{Binding DataContext.TogglePredatorSpecializationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            AutomationProperties.Name="{Binding Name, StringFormat='Predador em {0}'}" />
                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Cursor="Help" ToolTip="{Binding Description}" ToolTipService.InitialShowDelay="300" />
                </DockPanel>
                <TextBox Style="{StaticResource PaperLineTextBox}" FontSize="12" MaxLength="120" Margin="0,1,0,0"
                         Tag="{Binding PredatorOption.Text}"
                         Text="{Binding DataContext.PredatorSpecializationText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=LostFocus}"
                         Visibility="{Binding IsPredatorPending, Converter={StaticResource BoolVisibility}}"
                         ToolTip="Especialização gratuita do predador: escreva e saia do campo para aplicar."
                         AutomationProperties.Name="Texto livre da especializacao do predador" />
                <controls:SpecializationPager Margin="0,1,0,0" Text="{Binding Specialization, UpdateSourceTrigger=PropertyChanged}"
                                              LockedLine="{Binding PredatorSpecialization}"
                                              EditorName="{Binding Name, StringFormat='Especializacao de {0}'}"
                                              CountName="{Binding Name, StringFormat='Quantidade de especializacoes de {0}'}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type sheet:PersonalTraitLineViewModel}">
            <StackPanel Margin="0,0,0,10">
                <DockPanel>
                    <controls:DotTrack DockPanel.Dock="Right" Value="{Binding Rating, Mode=TwoWay}"
                                       AutomationProperties.Name="Pontos da habilidade pessoal" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" Margin="0,0,8,0"
                             Style="{StaticResource PaperLineTextBox}" FontSize="13" Tag="+ habilidade pessoal"
                             AutomationProperties.Name="Nome da habilidade pessoal" />
                </DockPanel>
                <controls:SpecializationPager Margin="0,1,0,0" Text="{Binding Specialization, UpdateSourceTrigger=PropertyChanged}"
                                              EditorName="Especializacao da habilidade pessoal"
                                              CountName="Quantidade de especializacoes pessoais" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel IsEnabled="{Binding CanEditBuild}">
        <Border Margin="8,0,8,14" Padding="12,10" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource VcsBorder}" Background="{DynamicResource VcsInput}"
                TextElement.Foreground="{DynamicResource VcsInputText}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNpc}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <DockPanel Margin="0,0,0,8" Visibility="{Binding IsCreating, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="Perfil inicial" Style="{StaticResource SkillStat}" Margin="0,0,10,0" />
                    <ComboBox ItemsSource="{Binding SkillProfileOptions}" SelectedIndex="{Binding SkillProfileIndex}" Width="190"
                              Tag="Perfil de habilidades" AutomationProperties.Name="Perfil de habilidades" />
                    <Border Style="{StaticResource SkillHelp}">
                        <Border.ToolTip>
                            <ToolTip><TextBlock Text="{x:Static sheet:CharacterEditorViewModel.SkillProfileHelp}" TextWrapping="Wrap" MaxWidth="340" /></ToolTip>
                        </Border.ToolTip>
                        <TextBlock Style="{StaticResource SkillHelpMark}" />
                    </Border>
                    <TextBlock Text="{Binding InitialSkillsDescription}" Margin="14,0,0,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource VcsInputDescription}" AutomationProperties.Name="Distribuicao inicial de habilidades" />
                    <TextBlock Text="{Binding InitialSkillsStatus}" ToolTip="{Binding InitialSkillsRemaining}" Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right"
                               TextWrapping="Wrap" TextAlignment="Right" FontSize="12" FontWeight="SemiBold"
                               AutomationProperties.Name="Habilidades que faltam">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource VcsAccentText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInitialSkillsComplete}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource VcsInputDescription}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                        <TextBlock Style="{StaticResource SkillStat}" Text="Especializações grátis:" />
                        <TextBlock Text="{Binding FreeSpecializationsAvailable}" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"
                                   AutomationProperties.Name="Especializacoes gratuitas disponiveis" />
                        <Border Style="{StaticResource SkillHelp}">
                            <Border.ToolTip>
                                <ToolTip><TextBlock Text="{x:Static sheet:CharacterEditorViewModel.SpecializationHelp}" TextWrapping="Wrap" MaxWidth="340" /></ToolTip>
                            </Border.ToolTip>
                            <TextBlock Style="{StaticResource SkillHelpMark}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,0" ToolTip="Marque ✦ ao lado de uma destas habilidades para receber a especialização gratuita do predador.">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PredatorSkillLegend}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="✦" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource VcsAccentText}" />
                        <TextBlock Style="{StaticResource SkillStat}" Text="Predador:" />
                        <TextBlock Text="{Binding PredatorSkillLegend}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"
                                   AutomationProperties.Name="Legenda do predador" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SkillStat}" Text="XP em habilidades:" />
                        <TextBlock Text="{Binding SkillsExperienceTotal}" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource VcsAccentText}" AutomationProperties.Name="XP gasto em habilidades" />
                        <Border Style="{StaticResource SkillHelp}">
                            <Border.ToolTip>
                                <ToolTip><TextBlock Text="{Binding SkillsExperienceHelp}" TextWrapping="Wrap" MaxWidth="340" /></ToolTip>
                            </Border.ToolTip>
                            <TextBlock Style="{StaticResource SkillHelpMark}" />
                        </Border>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding SkillGroups}" AutomationProperties.Name="Grupos de habilidades">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontFamily="Georgia" FontStyle="Italic" Margin="10,0,10,12" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- One grid row per skill index keeps Físicas, Sociais and Mentais aligned when a cell grows. -->
        <ItemsControl ItemsSource="{Binding Rows, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      AutomationProperties.Name="Linhas de habilidades">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Grid.Column="0" Margin="10,0" Content="{Binding Physical}" Focusable="False" VerticalAlignment="Top" />
                        <ContentControl Grid.Column="1" Margin="10,0" Content="{Binding Social}" Focusable="False" VerticalAlignment="Top" />
                        <ContentControl Grid.Column="2" Margin="10,0" Content="{Binding Mental}" Focusable="False" VerticalAlignment="Top" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>