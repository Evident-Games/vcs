<UserControl x:Class="VCS.Desktop.Controls.DotTrack"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <ItemsControl ItemsSource="{Binding Dots, ElementName=Root}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Tag="{Binding Number}" Click="SelectDot" Margin="1"
                            ToolTip="Clique para definir o nivel; repita no ponto selecionado para diminuir. No nivel 1, repita para zerar se permitido."
                            AutomationProperties.Name="{Binding Number}">
                        <!-- Minimal template: a sheet has ~60 tracks of 5 dots, so each element per dot counts. -->
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="3">
                                    <Ellipse x:Name="Dot" Width="13" Height="13" Stroke="{DynamicResource VcsAccent}" StrokeThickness="1.5" Fill="Transparent" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Filled}" Value="True">
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource VcsAccent}" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding Value, ElementName=Root}" Margin="9,0,0,0" VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
