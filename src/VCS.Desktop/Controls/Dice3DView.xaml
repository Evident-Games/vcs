<UserControl x:Class="VCS.Desktop.Controls.Dice3DView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="80" Height="108" Loaded="OnDieLoaded"
    AutomationProperties.Name="{Binding Value, StringFormat='Dado V5: {0}'}">
    <Border x:Name="DieTile" Background="{DynamicResource VcsCard}" BorderBrush="{DynamicResource VcsBorder}"
            BorderThickness="1" CornerRadius="10" Padding="4" TextElement.Foreground="{DynamicResource VcsCardText}">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsHunger}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource VcsSelection}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource VcsAccentBorder}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="64" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="DieKindLabel" HorizontalAlignment="Center" FontSize="8" FontWeight="Bold"
                       Foreground="{DynamicResource VcsInputDescription}" Margin="0,0,0,2">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="COMUM" />
                        <Setter Property="Foreground" Value="{DynamicResource VcsInputDescription}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHunger}" Value="True">
                                <Setter Property="Text" Value="FOME" />
                                <Setter Property="Foreground" Value="{DynamicResource VcsAccentText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Viewport3D x:Name="DieViewport" Grid.Row="1" ClipToBounds="True" IsHitTestVisible="False">
                <Viewport3D.Resources>
                    <DiffuseMaterial x:Key="DieMaterial" Brush="{DynamicResource VcsInput}" />
                </Viewport3D.Resources>
                <Viewport3D.Camera>
                    <PerspectiveCamera Position="0,0,3.8" LookDirection="0,0,-3.8"
                                       UpDirection="0,1,0" FieldOfView="48" />
                </Viewport3D.Camera>
            </Viewport3D>
            <TextBlock Grid.Row="2" Text="{Binding Value}" HorizontalAlignment="Center"
                       FontFamily="Georgia" FontSize="19" FontWeight="Bold"
                       Foreground="{DynamicResource VcsCardText}" />
        </Grid>
    </Border>
</UserControl>
