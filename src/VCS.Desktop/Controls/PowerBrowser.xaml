<UserControl x:Class="VCS.Desktop.Controls.PowerBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="230" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" MinWidth="240" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="8">
            <ListBox ItemsSource="{Binding Items, ElementName=Root}"
                     SelectedItem="{Binding Selected, ElementName=Root, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Catalogo de poderes">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,9">
                            <CheckBox IsChecked="{Binding IsKnown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{Binding Definition.Name}">
                                <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Text="{Binding Definition.Discipline}" FontSize="12" Margin="25,5,0,0"
                                       Foreground="{DynamicResource VcsInputDescription}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="DETALHES" Style="{StaticResource FieldLabel}" />
                    <ContentControl Content="{Binding Selected, ElementName=Root}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Heading}" FontSize="22" FontFamily="Georgia" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <TextBlock Text="{Binding Definition.Discipline}" Foreground="{DynamicResource VcsInputDescription}" Margin="0,0,0,12" />
                                    <CheckBox Content="Conhecido pelo personagem" IsChecked="{Binding IsKnown, Mode=TwoWay}"
                                              Margin="0,0,0,16" />
                                    <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource VcsAccent}" Margin="0,0,0,12" />
                                    <TextBlock Text="{Binding AdvancementInfo}" TextWrapping="Wrap" Foreground="{DynamicResource VcsInputDescription}" Margin="0,0,0,16" />
                                    <TextBlock Text="Descricao base" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding Definition.BaseDescription}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                    <TextBlock Text="Ingredientes" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding Definition.Ingredients}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                    <TextBlock Text="Custo" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding Definition.Cost}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                    <TextBlock Text="Parada de dados" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding Definition.DicePool}" TextWrapping="Wrap" Margin="0,0,0,16" />
                                    <TextBlock Text="Como funciona (resumo fornecido)" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Text="{Binding Definition.Summary}" TextWrapping="Wrap" LineHeight="22" />
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
