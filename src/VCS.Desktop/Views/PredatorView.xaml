<UserControl x:Class="VCS.Desktop.Views.PredatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- One quiet line: the predator's grants live in the rows below, in Disciplinas and in Habilidades. -->
    <DockPanel Margin="6,4" Visibility="{Binding HasAppliedPredator, Converter={StaticResource BoolVisibility}}">
        <Button DockPanel.Dock="Right" Command="{Binding RemovePredatorCommand}" Cursor="Hand" Focusable="False" VerticalAlignment="Center"
                Visibility="{Binding IsCreating, Converter={StaticResource BoolVisibility}}"
                ToolTip="Desfaz tudo o que o predador concedeu." AutomationProperties.Name="Remover predador">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <TextBlock Text="remover" TextDecorations="Underline" FontSize="11" Background="Transparent"
                               Foreground="{DynamicResource VcsMuted}" Opacity="0.76" />
                </ControlTemplate>
            </Button.Template>
        </Button>
        <TextBlock Text="{Binding AppliedPredatorSummary}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource VcsMuted}" Opacity="0.76" AutomationProperties.Name="Resumo do predador" />
    </DockPanel>
</UserControl>