<UserControl x:Class="VCS.Desktop.Views.SheetSectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VCS.Desktop.Controls"
    xmlns:views="clr-namespace:VCS.Desktop.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="Identity"><views:IdentitySheetView /></DataTemplate>
        <DataTemplate x:Key="AttributeRow">
            <StackPanel Margin="0,6">
                <TextBlock Text="{Binding Name}" FontSize="13" />
                <controls:DotTrack Value="{Binding Rating, Mode=TwoWay}" Minimum="1" AutomationProperties.Name="{Binding Key}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Attributes">
            <UniformGrid Columns="3" IsEnabled="{Binding CanEditBuild}">
                <StackPanel Margin="8">
                    <TextBlock Text="Fisicos" HorizontalAlignment="Center" FontFamily="Georgia" FontStyle="Italic" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding PhysicalAttributes}" ItemTemplate="{StaticResource AttributeRow}" />
                </StackPanel>
                <StackPanel Margin="8">
                    <TextBlock Text="Sociais" HorizontalAlignment="Center" FontFamily="Georgia" FontStyle="Italic" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding SocialAttributes}" ItemTemplate="{StaticResource AttributeRow}" />
                </StackPanel>
                <StackPanel Margin="8">
                    <TextBlock Text="Mentais" HorizontalAlignment="Center" FontFamily="Georgia" FontStyle="Italic" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding MentalAttributes}" ItemTemplate="{StaticResource AttributeRow}" />
                </StackPanel>
            </UniformGrid>
        </DataTemplate>
        <DataTemplate x:Key="Skills">
            <views:SkillsView />
        </DataTemplate>
        <DataTemplate x:Key="Disciplines">
            <views:DisciplineCatalogView />
        </DataTemplate>
        <DataTemplate x:Key="Advantages">
            <StackPanel>
                <StackPanel IsEnabled="{Binding CanEditBuild}">
                <views:AdvantageCatalogView DataContext="{Binding AdvantageCatalog}" Height="520" Margin="0,0,0,20" />
                <TextBlock Text="Vantagens" Style="{StaticResource SectionTitle}" />
                <controls:EditableTraitList DataContext="{Binding Advantages}" />
                <TextBlock Text="Desvantagens" Style="{StaticResource SectionTitle}" Margin="0,24,0,12" />
                <controls:EditableTraitList DataContext="{Binding Flaws}" />
                </StackPanel>
                <views:LoresheetCatalogView />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="State">
            <StackPanel>
                <UniformGrid Columns="2" Margin="0,0,0,20">
                    <StackPanel Margin="8">
                        <TextBlock Text="Saude" Style="{StaticResource SectionTitle}" />
                        <controls:DamageTrack Capacity="{Binding HealthCapacity}" Superficial="{Binding HealthSuperficial, Mode=TwoWay}"
                                              Aggravated="{Binding HealthAggravated, Mode=TwoWay}" AutomationProperties.Name="Saude na ficha" />
                    </StackPanel>
                    <StackPanel Margin="8">
                        <TextBlock Text="Forca de Vontade" Style="{StaticResource SectionTitle}" />
                        <controls:DamageTrack Capacity="{Binding WillpowerCapacity}" Superficial="{Binding WillpowerSuperficial, Mode=TwoWay}"
                                              Aggravated="{Binding WillpowerAggravated, Mode=TwoWay}" AutomationProperties.Name="Vontade na ficha" />
                    </StackPanel>
                </UniformGrid>
                <WrapPanel>
                    <StackPanel Margin="8,0,24,16">
                        <TextBlock Text="Fome" Style="{StaticResource FieldLabel}" />
                        <controls:DotTrack Value="{Binding Hunger, Mode=TwoWay}" Maximum="5" AutomationProperties.Name="Fome na ficha" />
                    </StackPanel>
                    <StackPanel Margin="8,0,24,16">
                        <TextBlock Text="Humanidade" Style="{StaticResource FieldLabel}" />
                        <controls:DotTrack Value="{Binding Humanity, Mode=TwoWay}" Maximum="10" AutomationProperties.Name="Humanidade na ficha" />
                    </StackPanel>
                    <StackPanel Margin="8,0,0,16">
                        <TextBlock Text="Potencia de Sangue" Style="{StaticResource FieldLabel}" />
                        <controls:DotTrack Value="{Binding BloodPotency, Mode=TwoWay}" Maximum="10"
                                           IsEnabled="{Binding CanEditBuild}"
                                           AutomationProperties.Name="Potencia de sangue na ficha" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="Sangue: valores de referencia preenchidos pela mesa; sem calculo automatico." TextWrapping="Wrap"
                           Foreground="{DynamicResource VcsMuted}" Margin="8" />
                <ItemsControl ItemsSource="{Binding BloodFields}" ItemTemplate="{StaticResource SheetExtraField}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Background">
            <StackPanel>
                <WrapPanel Margin="8,0,0,16">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Experiencia total" Style="{StaticResource FieldLabel}" />
                        <controls:NumericField Value="{Binding ExperienceTotal, Mode=TwoWay}" Maximum="1000000" AutomationProperties.Name="Experiencia total" />
                    </StackPanel>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="Experiencia gasta" Style="{StaticResource FieldLabel}" />
                        <controls:NumericField Value="{Binding ExperienceSpent, Mode=TwoWay}" Maximum="1000000" AutomationProperties.Name="Experiencia gasta" IsEnabled="{Binding CanStartAdvancement}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Disponivel" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding ExperienceAvailable}" FontSize="20" />
                    </StackPanel>
                </WrapPanel>
                <ItemsControl ItemsSource="{Binding BackgroundFields}" ItemTemplate="{StaticResource SheetExtraField}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Notes">
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="Wrap" MinHeight="240" MaxHeight="600" VerticalScrollBarVisibility="Auto" MaxLength="100000"
                     AutomationProperties.Name="Anotacoes do personagem" />
        </DataTemplate>
    </UserControl.Resources>
    <Border BorderBrush="{DynamicResource VcsBorder}" Background="{DynamicResource VcsCard}"
            BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12" MaxWidth="1100">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontFamily="Georgia" FontSize="22" HorizontalAlignment="Center"
                       Foreground="{DynamicResource VcsAccent}" Margin="0,0,0,16" />
            <ContentControl Content="{Binding Editor}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Key}" Value="Identity"><Setter Property="ContentTemplate" Value="{StaticResource Identity}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="Attributes"><Setter Property="ContentTemplate" Value="{StaticResource Attributes}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="Skills"><Setter Property="ContentTemplate" Value="{StaticResource Skills}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="Disciplines"><Setter Property="ContentTemplate" Value="{StaticResource Disciplines}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="Advantages"><Setter Property="ContentTemplate" Value="{StaticResource Advantages}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="State"><Setter Property="ContentTemplate" Value="{StaticResource State}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="Background"><Setter Property="ContentTemplate" Value="{StaticResource Background}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="Notes"><Setter Property="ContentTemplate" Value="{StaticResource Notes}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Editor.IsNpc}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value><DataTemplate><views:NpcSheetView DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:SheetSectionView}}" /></DataTemplate></Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </StackPanel>
    </Border>
</UserControl>
