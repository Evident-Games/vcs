<ui:FluentWindow x:Class="VCS.Desktop.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:VCS.Desktop.Views"
    xmlns:controls="clr-namespace:VCS.Desktop.Controls"
    xmlns:services="clr-namespace:VCS.Desktop.Services"
    Title="VCS - Vampire Character Sheet" Width="1240" Height="850" MinWidth="1000" MinHeight="680"
    WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True"
    Background="{DynamicResource VcsBackground}" Foreground="{DynamicResource VcsOuterText}"
    FontFamily="Segoe UI" FontSize="14">
    <ui:FluentWindow.Resources>
        <Style x:Key="ThemeOptionItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Header" Value="{Binding Name}" />
            <Setter Property="IsCheckable" Value="True" />
            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
            <Setter Property="Command" Value="{Binding DataContext.Display.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
            <Setter Property="CommandParameter" Value="{Binding Id}" />
        </Style>
        <Style x:Key="SheetThemeOptionItem" TargetType="MenuItem" BasedOn="{StaticResource ThemeOptionItem}">
            <Setter Property="Command" Value="{Binding DataContext.SelectSheetThemeCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.InputBindings>
            <KeyBinding Key="N" Modifiers="Control" Command="{Binding CreateCommand}" />
            <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}" />
            <KeyBinding Key="S" Modifiers="Control" Command="{Binding Editor.SaveCommand}" />
        </Grid.InputBindings>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="VCS  /  Vampire Character Sheet" Height="30" Padding="12,0" FontSize="11"
                     Foreground="{DynamicResource VcsHeaderText}" ButtonsForeground="{DynamicResource VcsHeaderText}" />
        <Border Grid.Row="1" BorderBrush="{DynamicResource VcsBorder}" BorderThickness="0,0,0,1" Padding="4,0">
            <Menu IsEnabled="{Binding IsIdle}" Background="Transparent" Foreground="{DynamicResource VcsHeaderText}"
                  AutomationProperties.Name="Menu principal">
                <MenuItem Header="_Arquivo">
                    <MenuItem Header="_Novo personagem" Command="{Binding CreateCommand}" InputGestureText="Ctrl+N" />
                    <MenuItem Header="_Abrir ficha" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" ToolTip="Abrir a ficha selecionada ou voltar a lista" />
                    <MenuItem Header="_Salvar" Command="{Binding Editor.SaveCommand}" IsEnabled="{Binding IsEditing}" InputGestureText="Ctrl+S" />
                    <MenuItem Header="Lista de personagens" Command="{Binding BackCommand}" IsEnabled="{Binding IsEditing}" />
                    <Separator />
                    <MenuItem Header="_Importar JSON..." Command="{Binding ImportCommand}" />
                    <MenuItem Header="_Exportar JSON..." Command="{Binding ExportCommand}" IsEnabled="{Binding CanActOnCharacter}" />
                    <MenuItem Header="Novo _NPC" Command="{Binding CreateNpcCommand}" />
                    <MenuItem Header="Exportar PDF preenchivel..." Command="{Binding ExportPdfCommand}" IsEnabled="{Binding CanActOnCharacter}" />
                </MenuItem>
                <MenuItem Header="_Editar">
                    <MenuItem Header="_Duplicar personagem" Command="{Binding DuplicateCommand}" IsEnabled="{Binding CanActOnCharacter}" />
                    <MenuItem Header="E_xcluir personagem..." Command="{Binding DeleteCommand}" IsEnabled="{Binding CanActOnCharacter}" />
                </MenuItem>
                <MenuItem Header="E_xibir">
                    <MenuItem Header="Modo de exibicao">
                        <MenuItem Header="Lista continua" IsCheckable="True" IsChecked="{Binding Display.IsContinuous, Mode=TwoWay}" />
                        <MenuItem Header="Abas" IsCheckable="True" IsChecked="{Binding Display.UseTabs, Mode=TwoWay}" />
                        <MenuItem Header="Bento compacto (cabe na tela)" IsCheckable="True" IsChecked="{Binding Display.UseBento, Mode=TwoWay}" />
                    </MenuItem>
                    <MenuItem Header="Organizar abas..." Command="{Binding ToggleLayoutSettingsCommand}" />
                    <MenuItem Header="Secoes" ItemsSource="{Binding Display.Sections}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header" Value="{Binding Title}" />
                                <Setter Property="IsCheckable" Value="True" />
                                <Setter Property="IsChecked" Value="{Binding IsVisible, Mode=TwoWay}" />
                                <Setter Property="StaysOpenOnClick" Value="True" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <MenuItem Header="Lista lateral de personagens" IsCheckable="True" IsChecked="{Binding Display.ShowSidebar, Mode=TwoWay}" />
                    <Separator />
                    <MenuItem Header="Temas">
                        <MenuItem Header="Aplicacao">
                            <MenuItem Header="Padrao" ItemsSource="{Binding Display.DefaultThemes}" ItemContainerStyle="{StaticResource ThemeOptionItem}" />
                            <MenuItem Header="Clas" ItemsSource="{Binding Display.ClanThemes}" ItemContainerStyle="{StaticResource ThemeOptionItem}" />
                            <MenuItem Header="Especiais" ItemsSource="{Binding Display.SpecialThemes}" ItemContainerStyle="{StaticResource ThemeOptionItem}" />
                        </MenuItem>
                        <MenuItem Header="Ficha atual" IsEnabled="{Binding IsEditing}">
                            <MenuItem Header="Seguir aplicacao" IsCheckable="True" IsChecked="{Binding Display.SheetFollowsApp, Mode=OneWay}"
                                      Command="{Binding SelectSheetThemeCommand}" CommandParameter="" />
                            <Separator />
                            <MenuItem Header="Padrao" ItemsSource="{Binding Display.DefaultSheetThemes}" ItemContainerStyle="{StaticResource SheetThemeOptionItem}" />
                            <MenuItem Header="Clas" ItemsSource="{Binding Display.ClanSheetThemes}" ItemContainerStyle="{StaticResource SheetThemeOptionItem}" />
                            <MenuItem Header="Especiais" ItemsSource="{Binding Display.SpecialSheetThemes}" ItemContainerStyle="{StaticResource SheetThemeOptionItem}" />
                        </MenuItem>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="_Ferramentas">
                    <MenuItem Header="Criar dump do banco..." Command="{Binding BackupCommand}" ToolTip="Salvar copia SQLite do banco completo" />
                    <MenuItem Header="Restaurar dump..." Command="{Binding RestoreCommand}" ToolTip="Substitui o banco completo, com confirmacao" />
                </MenuItem>
                <MenuItem Header="A_juda">
                    <MenuItem Header="Como usar o VCS" Command="{Binding ToggleHelpCommand}" />
                </MenuItem>
            </Menu>
        </Border>
        <Grid Grid.Row="2" IsEnabled="{Binding IsIdle}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="230" Padding="12" BorderBrush="{DynamicResource VcsBorder}" BorderThickness="0,0,1,0"
                    Background="{DynamicResource VcsCard}" TextElement.Foreground="{DynamicResource VcsCardText}" Visibility="{Binding Display.ShowSidebar, Converter={StaticResource BoolVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Personagens" FontSize="20" FontFamily="Georgia" Margin="0,0,0,12" />
                        <Border Background="{DynamicResource VcsInput}" BorderBrush="{DynamicResource VcsBorder}"
                                BorderThickness="1" CornerRadius="10" Margin="0,0,0,12" Padding="1">
                            <DockPanel>
                                <Button x:Name="NewSheetButton" DockPanel.Dock="Right" Content="+" Width="18" Height="18"
                                        MinWidth="18" MinHeight="18" Padding="0" FontSize="14" Click="OnNewSheetMenu"
                                        ToolTip="Criar ficha de PC ou NPC" AutomationProperties.Name="Adicionar ficha">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Circle" CornerRadius="9" Background="{DynamicResource VcsInput}"
                                                    BorderBrush="{DynamicResource VcsBorder}" BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  TextElement.Foreground="{DynamicResource VcsAccentText}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="{DynamicResource VcsSelection}" /><Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource VcsAccentBorder}" /></Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource VcsAccentBorder}" /><Setter TargetName="Circle" Property="BorderThickness" Value="2" /></Trigger>
                                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Circle" Property="Opacity" Value="0.5" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                     Background="{DynamicResource VcsCard}" Foreground="{DynamicResource VcsCardText}">
                                            <MenuItem Header="PC / Personagem" Command="{Binding CreateCommand}" AutomationProperties.Name="Criar PC" />
                                            <MenuItem Header="NPC / Ficha pratica" Command="{Binding CreateNpcCommand}" AutomationProperties.Name="Criar NPC" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Buscar por nome, cla ou cronica"
                                         Background="Transparent" BorderThickness="0" Padding="7,0" MinWidth="0" MinHeight="18" Height="18" FontSize="12"
                                         VerticalContentAlignment="Center" AutomationProperties.Name="Busca lateral de personagens" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SidebarRosterItem}"
                             Background="Transparent" AutomationProperties.Name="Lista lateral de personagens">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenCharacterCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" MinHeight="34" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" Padding="8,4">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                                     Background="{DynamicResource VcsCard}" Foreground="{DynamicResource VcsCardText}">
                                            <MenuItem Header="Abrir ficha" Command="{Binding OpenCharacterCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="Duplicar personagem" Command="{Binding DuplicateCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="Excluir personagem..." Command="{Binding DeleteCommand}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Tag>
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </Button.Tag>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                   FontFamily="Georgia" FontSize="14" />
                                        <TextBlock Text="{Binding Clan}" Foreground="{DynamicResource VcsInputDescription}"
                                                   TextTrimming="CharacterEllipsis" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <DockPanel Grid.Column="1" Margin="20,10,20,20">
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding OpenEditors}" Margin="0,0,0,10"
                          Visibility="{Binding HasOpenEditors, Converter={StaticResource BoolVisibility}}"
                          AutomationProperties.Name="Fichas abertas">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Tab" Margin="0,0,6,4" CornerRadius="6" BorderThickness="1" Padding="10,2,2,2"
                                BorderBrush="{DynamicResource VcsBorder}" Background="{DynamicResource VcsCard}">
                            <StackPanel Orientation="Horizontal">
                                <Button Background="Transparent" BorderThickness="0" Padding="0,2" MaxWidth="180"
                                        Command="{Binding DataContext.ActivateEditorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding TabTitle, StringFormat='Aba {0}'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="NPC" FontSize="10" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource VcsAccentText}"
                                                   Visibility="{Binding IsNpc, Converter={StaticResource BoolVisibility}}" />
                                        <TextBlock Text="{Binding TabTitle}" TextTrimming="CharacterEllipsis" FontFamily="Georgia"
                                                   Foreground="{DynamicResource VcsCardText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Content="×" Width="22" Height="22" Padding="0" Margin="4,0,0,0" Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource VcsInputDescription}" ToolTip="Fechar ficha"
                                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding TabTitle, StringFormat='Fechar {0}'}" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource VcsAccentBorder}" />
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource VcsSelection}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid>
            <views:HomeView Visibility="{Binding IsHome, Converter={StaticResource BoolVisibility}}" />
            <Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolVisibility}}">
                <ContentControl>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Content" Value="{Binding Editor}" />
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate><views:CharacterEditorView /></DataTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Display.UseBento}" Value="True" />
                                        <Condition Binding="{Binding HasManyOpen}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Content" Value="{x:Null}" />
                                    <Setter Property="ContentTemplate" Value="{x:Null}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <ItemsControl AutomationProperties.Name="Fichas lado a lado">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Display.UseBento}" Value="True" />
                                        <Condition Binding="{Binding HasManyOpen}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="ItemsSource" Value="{Binding OpenEditors}" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding DataContext.SheetColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Pane" Margin="4" CornerRadius="8" BorderThickness="1" Padding="10,6,6,8"
                                    services:SheetTheme.Id="{Binding EffectiveSheetThemeId}"
                                    BorderBrush="{DynamicResource VcsBorder}" Background="{DynamicResource VcsCard}"
                                    TextElement.Foreground="{DynamicResource VcsCardText}" PreviewMouseDown="OnSheetPaneMouseDown"
                                    AutomationProperties.Name="{Binding TabTitle, StringFormat='Painel {0}'}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="×" Width="22" Height="22" Padding="0" Background="Transparent"
                                                BorderThickness="0" Foreground="{DynamicResource VcsInputDescription}" ToolTip="Fechar ficha"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding TabTitle, StringFormat='Fechar painel {0}'}" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="11" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource VcsInputDescription}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TabTitle}" FontFamily="Georgia" FontSize="15" FontStyle="Italic"
                                                   Foreground="{DynamicResource VcsAccentText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <views:CharacterEditorView IsPane="True" />
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Pane" Property="BorderBrush" Value="{DynamicResource VcsAccentBorder}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            </Grid>
            </DockPanel>
            <Border Grid.ColumnSpan="2" Background="{DynamicResource VcsBackground}" BorderBrush="{DynamicResource VcsBorder}"
                    BorderThickness="1" Padding="24" Margin="36" MaxWidth="850"
                    Visibility="{Binding IsLayoutSettingsOpen, Converter={StaticResource BoolVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <DockPanel>
                            <Button Content="Concluir" Command="{Binding ToggleLayoutSettingsCommand}" DockPanel.Dock="Right" />
                            <TextBlock Text="Organizar abas" Style="{StaticResource SectionTitle}" />
                        </DockPanel>
                        <TextBlock Text="Arraste pela alca ⋮⋮ para mudar a ordem; as outras secoes abrem espaco. Use o mesmo nome de aba para agrupar secoes; a aba segue a primeira secao do grupo. As mudancas sao salvas automaticamente."
                                   TextWrapping="Wrap" Margin="0,8,0,16" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Modo:" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <RadioButton GroupName="SheetMode" Content="Lista continua" IsChecked="{Binding Display.IsContinuous, Mode=TwoWay}" Margin="0,0,16,0" />
                            <RadioButton GroupName="SheetMode" Content="Abas" IsChecked="{Binding Display.UseTabs, Mode=TwoWay}" Margin="0,0,16,0" />
                            <RadioButton GroupName="SheetMode" Content="Bento compacto" IsChecked="{Binding Display.UseBento, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock Text="Bento com varias fichas abertas: as fichas (PCs e NPCs) aparecem lado a lado em grade automatica: 2 fichas lado a lado, 3-4 em 2x2, 5+ em 3 colunas. Clique em um painel para torna-lo a ficha ativa."
                                   TextWrapping="Wrap" Foreground="{DynamicResource VcsInputDescription}" Margin="0,-8,0,16"
                                   AutomationProperties.Name="Nota de fichas lado a lado" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="SectionOrganizer" ItemsSource="{Binding Display.OrderedSections}"
                                      AutomationProperties.Name="Ordem das secoes">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="SectionRow" Margin="0,3" Padding="6,4" CornerRadius="6" BorderThickness="1"
                                            BorderBrush="{DynamicResource VcsBorder}" Background="{DynamicResource VcsCard}"
                                            TextElement.Foreground="{DynamicResource VcsCardText}" AllowDrop="True" DragOver="OnSectionDragOver" Drop="OnSectionDrop"
                                            AutomationProperties.Name="{Binding Title, StringFormat='Linha de {0}'}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="28" /><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Button Content="⋮⋮" Cursor="SizeAll" Width="22" Height="32" Padding="0" Margin="0,0,6,0"
                                                    FontSize="14" FontWeight="Bold" Background="Transparent" BorderThickness="0"
                                                    Foreground="{DynamicResource VcsInputDescription}" VerticalAlignment="Center"
                                                    PreviewMouseLeftButtonDown="OnSectionHandleDown" PreviewMouseMove="OnSectionHandleMove"
                                                    PreviewKeyDown="OnSectionHandleKey"
                                                    ToolTip="Arraste para reordenar. Pelo teclado: Alt + seta para cima/baixo."
                                                    AutomationProperties.Name="{Binding Title, StringFormat='Mover {0}'}" />
                                            <TextBlock Grid.Column="1" Text="{Binding SectionOrder}" VerticalAlignment="Center"
                                                       HorizontalAlignment="Center" FontSize="11" Opacity="0.6"
                                                       Foreground="{DynamicResource VcsInputDescription}" />
                                            <CheckBox Grid.Column="2" Content="{Binding Title}" IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="3" Margin="4,0">
                                                <TextBlock Text="Titulo da secao" Style="{StaticResource FieldLabel}" />
                                                <TextBox Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"
                                                         AutomationProperties.Name="{Binding Title, StringFormat='Titulo de {0}'}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Margin="4,0">
                                                <TextBlock Text="Nome da aba" Style="{StaticResource FieldLabel}" />
                                                <TextBox Text="{Binding TabName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"
                                                         AutomationProperties.Name="{Binding Title, StringFormat='Aba de {0}'}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.ColumnSpan="2" Background="{DynamicResource VcsBackground}" BorderBrush="{DynamicResource VcsBorder}"
                    BorderThickness="1" Padding="24" Margin="36" MaxWidth="850"
                    Visibility="{Binding IsHelpOpen, Converter={StaticResource BoolVisibility}}">
                <StackPanel>
                    <TextBlock Text="VCS - Como usar" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Arquivo: criar, abrir, salvar e importar/exportar fichas JSON.&#10;&#10;Editar: duplicar ou excluir a ficha aberta ou selecionada.&#10;&#10;Exibir: escolher temas, ficha continua e organizar abas. Use o mesmo nome para agrupar secoes.&#10;&#10;Ferramentas: criar e restaurar dumps do banco completo.&#10;&#10;Na lista, abra uma ficha com duplo clique ou Enter. Ctrl+N cria, Ctrl+O abre e Ctrl+S salva. Alteracoes validas tambem sao salvas automaticamente."
                               TextWrapping="Wrap" Margin="0,0,0,24" />
                    <Button Content="Fechar ajuda" Command="{Binding ToggleHelpCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource VcsBorder}" Padding="24,10" TextElement.Foreground="{DynamicResource VcsFooterText}">
            <StackPanel>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource VcsAccentText}" TextWrapping="Wrap" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Atualizar" Command="{Binding UpdateCommand}" Margin="12,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AvailableUpdate}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource VcsFooterText}" TextWrapping="Wrap" FontSize="12"
                               VerticalAlignment="Center" />
                </DockPanel>
                <ProgressBar Height="3" IsIndeterminate="True" Margin="0,6,0,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
