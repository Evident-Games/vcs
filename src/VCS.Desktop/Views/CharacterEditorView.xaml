<UserControl x:Class="VCS.Desktop.Views.CharacterEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:VCS.Desktop.Views"
    xmlns:controls="clr-namespace:VCS.Desktop.Controls"
    xmlns:services="clr-namespace:VCS.Desktop.Services"
    services:SheetTheme.Id="{Binding EffectiveSheetThemeId}">
    <UserControl.Style>
        <!-- The sheet paints its own surface so a sheet theme can differ from the application theme. -->
        <Style TargetType="views:CharacterEditorView">
            <Setter Property="Background" Value="{DynamicResource VcsBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource VcsOuterText}" />
            <Style.Triggers>
                <Trigger Property="IsPane" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource VcsCardText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <DataTemplate x:Key="Continuous">
            <ScrollViewer x:Name="SheetScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.Name="Ficha completa">
                <ItemsControl ItemsSource="{Binding VisibleSections}" Margin="0,0,12,0">
                    <ItemsControl.ItemTemplate><DataTemplate><views:SheetSectionView /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate x:Key="Tabbed">
            <TabControl ItemsSource="{Binding VisibleTabs}" SelectedItem="{Binding SelectedTab}"
                        Background="Transparent" BorderThickness="0" AutomationProperties.Name="Secoes da ficha">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate></TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,10,0">
                            <ItemsControl ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemTemplate><DataTemplate><views:SheetSectionView /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </DataTemplate>
        <DataTemplate x:Key="Bento">
            <ItemsControl ItemsSource="{Binding VisibleSections}" Margin="0,0,4,0" AutomationProperties.Name="Ficha em bento">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><controls:BentoPanel Columns="4" Gap="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="controls:BentoPanel.ColumnSpan" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Key}" Value="Identity"><Setter Property="controls:BentoPanel.ColumnSpan" Value="2" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="Attributes"><Setter Property="controls:BentoPanel.ColumnSpan" Value="2" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="Skills">
                                <Setter Property="controls:BentoPanel.ColumnSpan" Value="2" />
                                <Setter Property="controls:BentoPanel.RowWeight" Value="1.6" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="Notes"><Setter Property="controls:BentoPanel.ColumnSpan" Value="2" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource VcsBorder}" Background="{DynamicResource VcsCard}" TextElement.Foreground="{DynamicResource VcsCardText}"
                                BorderThickness="1" CornerRadius="8" Padding="8,6,4,6"
                                AutomationProperties.Name="{Binding Title, StringFormat=Bloco {0}}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource VcsBorder}" BorderThickness="0,0,0,1"
                                        Margin="0,0,4,4" Padding="0,0,0,3">
                                    <TextBlock Text="{Binding Title}" FontFamily="Georgia" FontSize="13" FontStyle="Italic"
                                               Foreground="{DynamicResource VcsAccentText}" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              controls:ScrollChaining.IsEnabled="True">
                                    <views:SheetSectionView IsCompact="True" Margin="0,0,6,0">
                                        <views:SheetSectionView.LayoutTransform>
                                            <ScaleTransform ScaleX="0.85" ScaleY="0.85" />
                                        </views:SheetSectionView.LayoutTransform>
                                    </views:SheetSectionView>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate x:Key="NpcQuick">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Ficha de NPC">
                <views:NpcQuickSheetView Margin="0,0,12,0" />
            </ScrollViewer>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPane, RelativeSource={RelativeSource AncestorType=views:CharacterEditorView}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <TextBlock Text="{Binding Status}" DockPanel.Dock="Right" Foreground="{DynamicResource VcsAccentText}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Name, ValidatesOnNotifyDataErrors=False}" FontFamily="Georgia" FontSize="27" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPane, RelativeSource={RelativeSource AncestorType=views:CharacterEditorView}}" Value="True">
                            <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.85" ScaleY="0.85" /></Setter.Value></Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource Continuous}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Display.UseTabs}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource Tabbed}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Display.UseBento}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource Bento}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPane, RelativeSource={RelativeSource AncestorType=views:CharacterEditorView}}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource Continuous}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsNpc}" Value="True">
                                <Setter Property="ContentTemplate" Value="{StaticResource NpcQuick}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <TextBlock Text="Nenhuma secao visivel. Ative uma secao em Exibir > Organizar abas."
                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="{Binding NoVisibleSections, Converter={StaticResource BoolVisibility}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNpc}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <ScrollViewer Grid.Row="2" MaxHeight="100" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,8,0,0" />
                        <Style.Triggers>
                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                            <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="{Binding ValidationSummary}" Foreground="{DynamicResource VcsAccentText}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource VcsAccentText}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
