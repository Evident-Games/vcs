<UserControl x:Class="VCS.Desktop.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Personagens" FontFamily="Georgia" FontSize="36" />
            <TextBlock Text="Identidades, escolhas e historias sob o mesmo teto." Margin="0,8,0,0"
                       Foreground="{DynamicResource VcsInputDescription}" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Arquivo > Novo personagem para criar. Use Arquivo > Abrir ficha, Enter ou duplo clique na ficha para abrir."
                   Foreground="{DynamicResource VcsInputDescription}" Margin="0,0,0,20" TextWrapping="Wrap" />
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MaxWidth="540" HorizontalAlignment="Stretch"
                     AutomationProperties.Name="Buscar por nome, cla ou cronica" ToolTip="Buscar por nome, cla ou cronica" />
            <TextBlock Grid.Column="1" Text="{Binding CountLabel}" VerticalAlignment="Center" Margin="24,0,0,0"
                       Foreground="{DynamicResource VcsInputDescription}" />
        </Grid>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}"
                         HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource CharacterRosterItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Lista de personagens" PreviewMouseDown="OnCharacterMouseDown">
                    <ListBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding OpenCommand}" />
                    </ListBox.InputBindings>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,5" MinHeight="38"
                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Grid.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                                 Background="{DynamicResource VcsCard}" Foreground="{DynamicResource VcsCardText}">
                                        <MenuItem Header="Abrir ficha" Command="{Binding OpenCharacterCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="Duplicar personagem" Command="{Binding DuplicateCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Excluir personagem..." Command="{Binding DeleteCommand}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontFamily="Georgia" FontSize="16"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="16,0,8,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Clan}" Foreground="{DynamicResource VcsInputDescription}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Chronicle}" Margin="12,0,0,0"
                                               Foreground="{DynamicResource VcsInputDescription}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding UpdatedUtc, StringFormat='{}{0:dd/MM/yy}'}"
                                           FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource VcsInputDescription}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
                    <TextBlock Text="Nenhuma ficha encontrada" FontFamily="Georgia" FontSize="26" HorizontalAlignment="Center" />
                    <TextBlock Text="Crie um personagem, importe um JSON ou ajuste a busca." Margin="0,12,0,0"
                               Foreground="{DynamicResource VcsInputDescription}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
