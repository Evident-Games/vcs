<UserControl x:Class="VCS.Desktop.Views.AdvantageCatalogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VCS.Desktop.Controls">
    <ItemsControl ItemsSource="{Binding Families}" AutomationProperties.Name="Familias de vantagens e defeitos">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <StackPanel Margin="8,12" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding SelectionHint}" TextWrapping="Wrap" Foreground="{DynamicResource VcsMuted}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6" ToolTip="{Binding Description}">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center" />
                                        <controls:DotTrack Grid.Column="1" Margin="8,0,0,0" Value="{Binding Rating, Mode=TwoWay}"
                                                           Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                           AutomationProperties.Name="{Binding Name, StringFormat='Pontos de {0}'}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource VcsMuted}" FontSize="11" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource VcsMuted}"
                                               Visibility="{Binding IsSelected, Converter={StaticResource BoolVisibility}}" />
                                    <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{DynamicResource VcsAccent}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding PersonalEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8">
                                    <TextBlock Text="{Binding MeritKind}" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"
                                                 IsReadOnly="{Binding IsNameReadOnly}" AutomationProperties.Name="Nome da caracteristica pessoal" />
                                        <controls:DotTrack Grid.Column="1" Value="{Binding Rating, Mode=TwoWay}" Margin="8,0,0,0"
                                                           IsEnabled="{Binding CanEditRating}" AutomationProperties.Name="Pontos da caracteristica pessoal" />
                                    </Grid>
                                    <TextBlock Text="Descricao / anotacoes" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                             TextWrapping="Wrap" MinHeight="48" MaxHeight="150" VerticalScrollBarVisibility="Auto" MaxLength="20000"
                                             IsReadOnly="{Binding IsNameReadOnly}" AutomationProperties.Name="Descricao da caracteristica pessoal" />
                                    <TextBlock Text="{Binding AdvancementInfo}" TextWrapping="Wrap" Foreground="{DynamicResource VcsMuted}" />
                                    <Button Content="Remover linha" HorizontalAlignment="Left" IsEnabled="{Binding CanEditRating}"
                                            Command="{Binding DataContext.RemovePersonalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="+ Vantagem pessoal" Command="{Binding AddAdvantageCommand}" Margin="0,0,8,0" />
                        <Button Content="+ Defeito pessoal" Command="{Binding AddFlawCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource VcsAccent}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ConflictWarning}" Foreground="{DynamicResource VcsAccent}" TextWrapping="Wrap" />
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
