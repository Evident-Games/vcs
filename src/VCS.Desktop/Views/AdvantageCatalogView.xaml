<UserControl x:Class="VCS.Desktop.Views.AdvantageCatalogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VCS.Desktop.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"
                     AutomationProperties.Name="Buscar vantagem ou defeito" ToolTip="Buscar nome, grupo ou descricao" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" AutomationProperties.Name="Filtrar vantagens ou defeitos" />
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding CountLabel}" Style="{StaticResource FieldLabel}" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Catalogo de vantagens e defeitos">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,9">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Group}" FontSize="12" Foreground="{DynamicResource VcsMuted}" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding PointsLabel, StringFormat='{}{0} ponto(s)'}" FontSize="12" Foreground="{DynamicResource VcsMuted}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Nenhuma entrada encontrada." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="DETALHES" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding SelectedEntry.Name}" FontSize="22" FontFamily="Georgia" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding SelectedSummary}" Foreground="{DynamicResource VcsMuted}" TextWrapping="Wrap" Margin="0,0,0,16" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,16" />
                        <StackPanel IsEnabled="{Binding HasSelection}">
                            <TextBlock Text="Pontos" Style="{StaticResource FieldLabel}" />
                            <controls:NumericField Value="{Binding Points, Mode=TwoWay}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                   AutomationProperties.Name="Pontos da vantagem ou defeito" HorizontalAlignment="Left" />
                            <Button Content="Adicionar a ficha" Command="{Binding AddSelectedCommand}" Margin="0,12,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource VcsAccent}" Margin="0,12,0,0" />
                        <TextBlock Text="Efeitos de referencia, sem bonus automaticos. Inimigo: 1+ na referencia, 1-5 na ficha."
                                   TextWrapping="Wrap" Foreground="{DynamicResource VcsMuted}" Margin="0,16,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
