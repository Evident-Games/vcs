<UserControl x:Class="VCS.Desktop.Views.NpcQuickSheetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VCS.Desktop.Controls"
    xmlns:views="clr-namespace:VCS.Desktop.Views"
    xmlns:vm="clr-namespace:VCS.Desktop.ViewModels">
    <UserControl.Resources>
        <Style x:Key="NpcLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource VcsAccent}" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <!-- Round "bolinha" buttons, same look as the player sheet's mini buttons. -->
        <Style x:Key="NpcSmallButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Width="18" Height="18" CornerRadius="9" BorderThickness="1"
                                BorderBrush="{DynamicResource VcsBorder}" Background="{DynamicResource VcsInput}">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="12" LineHeight="12" LineStackingStrategy="BlockLineHeight"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource VcsAccent}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource VcsAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Typed box count between the − and + bolinhas. -->
        <Style x:Key="NpcCount" TargetType="TextBox" BasedOn="{StaticResource PaperLineTextBox}">
            <Setter Property="Width" Value="38" />
            <Setter Property="MaxLength" Value="3" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0" />
        </Style>
        <Style x:Key="NpcTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource VcsAccent}" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Same heading as the player sheet sections. -->
        <Style x:Key="NpcSection" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource VcsAccent}" />
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="NpcGroup" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="NpcCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="NpcText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="MaxLength" Value="20000" />
            <Setter Property="MinHeight" Value="70" />
            <Setter Property="MaxHeight" Value="320" />
        </Style>
    </UserControl.Resources>
    <StackPanel AutomationProperties.Name="Ficha rapida de NPC">
        <Border Style="{StaticResource NpcCard}">
            <StackPanel>
                <TextBlock Text="{Binding IdentityHeading}" Style="{StaticResource NpcSection}" AutomationProperties.Name="FICHA DE NPC" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="120" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Nome" Style="{StaticResource NpcLabel}" />
                    <TextBox Grid.Column="1" Style="{StaticResource PaperLineTextBox}" MaxLength="120" Margin="0,0,16,0"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome do NPC" />
                    <TextBlock Grid.Column="2" Text="Crônica" Style="{StaticResource NpcLabel}" />
                    <TextBox Grid.Column="3" Style="{StaticResource PaperLineTextBox}" MaxLength="200"
                             Text="{Binding Chronicle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cronica do NPC" />
                    <TextBlock Grid.Row="1" Text="Clã" Style="{StaticResource NpcLabel}" Margin="0,10,8,0" />
                    <controls:ClanSelector Grid.Row="1" Grid.Column="1" Margin="0,10,16,0" VerticalAlignment="Center"
                                           Value="{Binding Clan, Mode=TwoWay}" Catalog="{Binding KnownClans}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Geração" Style="{StaticResource NpcLabel}" Margin="0,10,8,0"
                               ToolTip="{Binding GenerationGuidance}" />
                    <controls:NumericField Grid.Row="1" Grid.Column="3" Width="76" HorizontalAlignment="Left" Margin="0,10,0,0"
                                           Value="{Binding Generation, Mode=TwoWay}" Minimum="1" Maximum="16"
                                           VerticalAlignment="Center" AutomationProperties.Name="Geracao do NPC" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource NpcCard}">
            <StackPanel>
                <TextBlock Text="Combate" Style="{StaticResource NpcSection}" />
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Vitalidade" Style="{StaticResource NpcLabel}" />
                    <controls:BoxTrack Grid.Column="2" Margin="10,0,0,0" Capacity="{Binding NpcHealthCapacity}" BoxSize="22" GroupSize="5"
                                       Superficial="{Binding HealthSuperficial, Mode=TwoWay}" Aggravated="{Binding HealthAggravated, Mode=TwoWay}"
                                       ToolTip="Clique: vazia → superficial (■) → agravado (X) → vazia" AutomationProperties.Name="Vitalidade NPC" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="−" Style="{StaticResource NpcSmallButton}" Command="{Binding RemoveNpcHealthBoxCommand}"
                                ToolTip="Remover uma caixa de Vitalidade" AutomationProperties.Name="Remover caixa de vitalidade" />
                        <TextBox Style="{StaticResource NpcCount}" Text="{Binding NpcHealthText, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Total de caixas de Vitalidade (escreva o valor)" AutomationProperties.Name="Total de vitalidade" />
                        <Button Content="+" Style="{StaticResource NpcSmallButton}" Command="{Binding AddNpcHealthBoxCommand}"
                                ToolTip="Adicionar uma caixa de Vitalidade" AutomationProperties.Name="Adicionar caixa de vitalidade" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Força de Vontade" Style="{StaticResource NpcLabel}" Margin="0,6,8,0" />
                    <controls:BoxTrack Grid.Row="1" Grid.Column="2" Mode="Cross" Capacity="{Binding NpcWillpowerCapacity}" BoxSize="22" GroupSize="5"
                                       Aggravated="{Binding WillpowerAggravated, Mode=TwoWay}" Margin="10,6,0,0"
                                       ToolTip="Clique para marcar ou limpar um X" AutomationProperties.Name="Vontade NPC" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
                        <Button Content="−" Style="{StaticResource NpcSmallButton}" Command="{Binding RemoveNpcWillpowerBoxCommand}"
                                ToolTip="Remover uma caixa de Força de Vontade" AutomationProperties.Name="Remover caixa de vontade" />
                        <TextBox Style="{StaticResource NpcCount}" Text="{Binding NpcWillpowerText, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="Total de caixas de Força de Vontade (escreva o valor)" AutomationProperties.Name="Total de vontade" />
                        <Button Content="+" Style="{StaticResource NpcSmallButton}" Command="{Binding AddNpcWillpowerBoxCommand}"
                                ToolTip="Adicionar uma caixa de Força de Vontade" AutomationProperties.Name="Adicionar caixa de vontade" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Potência de Sangue" Style="{StaticResource NpcLabel}" />
                    <controls:DotTrack Grid.Column="1" Grid.ColumnSpan="3" Value="{Binding BloodPotency, Mode=TwoWay}" Maximum="10" HorizontalAlignment="Left"
                                       ToolTip="Preenche automaticamente Surto, Recuperação e Bônus de poder (editáveis)."
                                       AutomationProperties.Name="Potencia de sangue NPC" />
                    <TextBlock Grid.Row="1" Text="Surto de Sangue" Style="{StaticResource NpcLabel}" Margin="0,8,8,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource PaperLineTextBox}" MaxLength="500" Margin="0,8,16,0"
                             Text="{Binding NpcBloodSurge.Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Surto de Sangue NPC" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Quantidade recuperada" Style="{StaticResource NpcLabel}" Margin="0,8,8,0" />
                    <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource PaperLineTextBox}" MaxLength="500" Margin="0,8,0,0"
                             Text="{Binding NpcDamageMend.Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Quantidade recuperada NPC" />
                    <TextBlock Grid.Row="2" Text="Bônus de poder" Style="{StaticResource NpcLabel}" Margin="0,8,8,0" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource PaperLineTextBox}" MaxLength="500" Margin="0,8,16,0"
                             Text="{Binding NpcPowerBonus.Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bonus de poder NPC" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Fome" Style="{StaticResource NpcLabel}" Margin="0,8,8,0" />
                    <controls:BoxTrack Grid.Row="2" Grid.Column="3" Mode="Count" Capacity="5" BoxSize="22" Margin="0,6,0,0"
                                       Value="{Binding Hunger, Mode=TwoWay}" AutomationProperties.Name="Fome NPC" />
                </Grid>

                <DockPanel Margin="0,18,0,4">
                    <Button DockPanel.Dock="Right" Content="+" Style="{StaticResource NpcSmallButton}" Command="{Binding AddNpcAttackCommand}"
                            ToolTip="Adicionar ataque" AutomationProperties.Name="Adicionar ataque" />
                    <TextBlock Text="Ataques" Style="{StaticResource NpcTitle}" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding NpcAttacks}" AutomationProperties.Name="Ataques do NPC">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource VcsBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6,6,8" Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Ataque" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                                    <TextBlock Grid.Column="1" Text="Parada de dados" Style="{StaticResource FieldLabel}" Margin="8,0,0,2" />
                                    <TextBlock Grid.Column="2" Text="Bônus de dano" Style="{StaticResource FieldLabel}" Margin="8,0,0,2" />
                                    <TextBlock Grid.Column="3" Text="Tipo de dano" Style="{StaticResource FieldLabel}" Margin="8,0,0,2" />
                                    <Button Grid.Column="4" Grid.RowSpan="2" Content="×" Style="{StaticResource NpcSmallButton}" Margin="8,0,0,0"
                                            Command="{Binding DataContext.RemoveNpcAttackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" ToolTip="Remover ataque" AutomationProperties.Name="Remover ataque" />
                                    <TextBox Grid.Row="1" Style="{StaticResource PaperLineTextBox}" MaxLength="200"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Ataque" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource PaperLineTextBox}" MaxLength="200" Margin="8,0,0,0"
                                             Text="{Binding DicePool, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Parada de dados" />
                                    <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource PaperLineTextBox}" MaxLength="200" Margin="8,0,0,0"
                                             Text="{Binding DamageBonus, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bonus de dano" />
                                    <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource PaperLineTextBox}" MaxLength="200" Margin="8,0,0,0"
                                             Text="{Binding DamageType, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tipo de dano" />
                                    <DockPanel Grid.Row="2" Grid.ColumnSpan="4" Margin="0,8,0,0">
                                        <TextBlock Text="Disciplinas ativas:" Style="{StaticResource NpcLabel}" FontSize="12" />
                                        <TextBox Style="{StaticResource PaperLineTextBox}" MaxLength="500"
                                                 Text="{Binding ActiveDisciplines, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Disciplinas ativas" />
                                    </DockPanel>
                                    <DockPanel Grid.Row="3" Grid.ColumnSpan="4" Margin="0,6,0,0">
                                        <TextBlock Text="Notas:" Style="{StaticResource NpcLabel}" FontSize="12" VerticalAlignment="Top" Margin="0,3,8,0" />
                                        <TextBox Style="{StaticResource PaperLineTextBox}" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="True"
                                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Notas do ataque" />
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource NpcCard}">
            <StackPanel>
                <TextBlock Text="Atributos" Style="{StaticResource NpcSection}" />
                <UniformGrid Columns="3">
                    <StackPanel>
                        <TextBlock Text="Físicos" Style="{StaticResource NpcGroup}" />
                        <controls:DotTrack Value="{Binding NpcPhysical, Mode=TwoWay}" Maximum="5" HorizontalAlignment="Center"
                                           ToolTip="Força, Destreza e Vigor juntos" AutomationProperties.Name="Fisicos do NPC" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Sociais" Style="{StaticResource NpcGroup}" />
                        <controls:DotTrack Value="{Binding NpcSocial, Mode=TwoWay}" Maximum="5" HorizontalAlignment="Center"
                                           ToolTip="Carisma, Manipulação e Autocontrole juntos" AutomationProperties.Name="Sociais do NPC" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Mentais" Style="{StaticResource NpcGroup}" />
                        <controls:DotTrack Value="{Binding NpcMental, Mode=TwoWay}" Maximum="5" HorizontalAlignment="Center"
                                           ToolTip="Inteligência, Raciocínio e Determinação juntos" AutomationProperties.Name="Mentais do NPC" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource NpcCard}">
            <StackPanel>
                <TextBlock Text="Habilidades" Style="{StaticResource NpcSection}" />
                <views:SkillsView />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource NpcCard}">
            <StackPanel>
                <TextBlock Text="Disciplinas" Style="{StaticResource NpcSection}" />
                <views:DisciplineCatalogView />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource NpcCard}">
            <StackPanel>
                <TextBlock Text="Vantagens e defeitos" Style="{StaticResource NpcSection}" />
                <views:AdvantageCatalogView DataContext="{Binding AdvantageCatalog}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=FrameworkElement}}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource NpcCard}">
            <StackPanel>
                <TextBlock Text="Histórico" Style="{StaticResource NpcSection}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Idade verdadeira" Style="{StaticResource NpcLabel}" />
                    <TextBox Grid.Column="1" Style="{StaticResource PaperLineTextBox}" MaxLength="200" Margin="0,0,16,0"
                             Text="{Binding NpcTrueAge.Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Idade verdadeira do NPC" />
                    <TextBlock Grid.Column="2" Text="Idade aparente" Style="{StaticResource NpcLabel}" />
                    <TextBox Grid.Column="3" Style="{StaticResource PaperLineTextBox}" MaxLength="200"
                             Text="{Binding NpcApparentAge.Value, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Idade aparente do NPC" />
                </Grid>
                <TextBlock Text="Notas" Style="{StaticResource NpcTitle}" Margin="0,16,0,6" />
                <TextBox Style="{StaticResource NpcText}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MinHeight="80"
                         AutomationProperties.Name="Notas do NPC" />
                <TextBlock Text="História" Style="{StaticResource NpcTitle}" Margin="0,16,0,6" />
                <TextBox Style="{StaticResource NpcText}" Text="{Binding NpcHistory.Value, UpdateSourceTrigger=PropertyChanged}" MinHeight="140"
                         AutomationProperties.Name="Historia do NPC" />
                <TextBlock Text="Aparência" Style="{StaticResource NpcTitle}" Margin="0,16,0,6" />
                <TextBox Style="{StaticResource NpcText}" Text="{Binding NpcAppearance.Value, UpdateSourceTrigger=PropertyChanged}" MinHeight="80"
                         AutomationProperties.Name="Aparencia do NPC" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>