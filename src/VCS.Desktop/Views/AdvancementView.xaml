<UserControl x:Class="VCS.Desktop.Views.AdvancementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VCS.Desktop.Controls">
    <StackPanel Margin="8" AutomationProperties.Name="Experiencia da ficha">
        <TextBlock Text="Experiencia" Style="{StaticResource FieldLabel}" />
        <TextBlock Text="{Binding CampaignXpSummary}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <WrapPanel>
            <StackPanel Margin="0,0,24,8">
                <TextBlock Text="XP inicial da idade" Style="{StaticResource FieldLabel}" />
                <TextBlock Text="{Binding InitialExperience}" FontSize="20" />
            </StackPanel>
            <StackPanel Margin="0,0,24,8">
                <TextBlock Text="XP de campanha recebido do mestre" Style="{StaticResource FieldLabel}" />
                <controls:NumericField Value="{Binding CampaignExperienceTotal, Mode=TwoWay}" Maximum="{Binding MaximumCampaignExperience}"
                                       AutomationProperties.Name="XP de campanha recebido" />
            </StackPanel>
            <StackPanel Margin="0,0,24,8">
                <TextBlock Text="XP total" Style="{StaticResource FieldLabel}" />
                <TextBlock Text="{Binding ExperienceTotal}" FontSize="20" AutomationProperties.Name="XP total da evolucao" />
            </StackPanel>
            <StackPanel Margin="0,0,24,8">
                <TextBlock Text="XP gasto (calculado)" Style="{StaticResource FieldLabel}" />
                <TextBlock Text="{Binding ExperienceSpent}" FontSize="20" AutomationProperties.Name="Total gasto de XP" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="XP disponivel" Style="{StaticResource FieldLabel}" />
                <TextBlock Text="{Binding ExperienceAvailable}" FontSize="20" />
            </StackPanel>
        </WrapPanel>
        <TextBlock Text="{Binding ExperienceWarning}" Foreground="{DynamicResource VcsAccent}" TextWrapping="Wrap"
                   AutomationProperties.Name="Aviso de XP faltante" />
        <ItemsControl ItemsSource="{Binding ExperienceBreakdown}">
            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
