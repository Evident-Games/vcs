<UserControl x:Class="VCS.Desktop.Views.HumanityView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VCS.Desktop.Controls">
    <Border Background="{DynamicResource VcsBackground}" BorderBrush="{DynamicResource VcsBorder}"
            BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,8">
        <StackPanel>
            <TextBlock Text="Humanidade / Maculas e Remorso" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="{Binding HumanityDescription}" TextWrapping="Wrap" AutomationProperties.Name="Referencia da Humanidade atual" />
            <TextBlock Text="{Binding HumanitySocialReference}" TextWrapping="Wrap" Foreground="{DynamicResource VcsMuted}" Margin="0,6" />
            <TextBlock Text="WASSAIL: controle da Besta / Narrador. A ficha e mantida e pode continuar sendo editada."
                       TextWrapping="Wrap" FontWeight="Bold" Foreground="{DynamicResource VcsAccent}" Margin="0,6"
                       Visibility="{Binding IsWassail, Converter={StaticResource BoolVisibility}}" />
            <DockPanel Margin="0,6">
                <controls:NumericField DockPanel.Dock="Right" Value="{Binding Stains, Mode=TwoWay}" Minimum="0" Maximum="1000000"
                                       AutomationProperties.Name="Maculas" />
                <TextBlock Text="Maculas registradas" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="Atos monstruosos geram Maculas. Nao ha dano ou rolagem automatica: a mesa determina quando aplicar a consequencia e o resultado do Remorso."
                       TextWrapping="Wrap" Foreground="{DynamicResource VcsMuted}" Margin="0,6" />
            <WrapPanel>
                <Button Content="Aplicar 1 Agravado na Vontade" Command="{Binding ApplyStainDamageCommand}" Margin="0,4,8,4"
                        AutomationProperties.Name="Aplicar dano de Maculas" />
                <Button Content="Falha no Remorso: limpar Maculas e -1 Humanidade" Command="{Binding FailRemorseCommand}" Margin="0,4"
                        AutomationProperties.Name="Registrar falha no Remorso" />
            </WrapPanel>
            <Expander Header="Referencia de todos os niveis de Humanidade" AutomationProperties.Name="Niveis de Humanidade" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding HumanityLevels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource VcsBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Level, StringFormat=Humanidade {0}}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
