<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="VcsBackground" Color="#0C0B0D" />
    <SolidColorBrush x:Key="VcsCard" Color="#1B191C" />
    <!-- Texto de dentro: cartoes, campos, listas e menus abertos. -->
    <SolidColorBrush x:Key="VcsText" Color="#FEF4E3" />
    <!-- Texto de fora: direto sobre o fundo da janela (titulo, menu principal, cabecalho e status). -->
    <SolidColorBrush x:Key="VcsOuterText" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsMuted" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsBorder" Color="#B1AAA0" />
    <SolidColorBrush x:Key="VcsAccent" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsInput" Color="#78131F" />
    <SolidColorBrush x:Key="VcsHover" Color="#8D8373" />
    <SolidColorBrush x:Key="VcsSelection" Color="#8D8373" />
</ResourceDictionary>