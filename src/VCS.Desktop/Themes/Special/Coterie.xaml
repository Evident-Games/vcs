<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#0C0B0D" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#1B191C" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#B1AAA0" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#78131F" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#8D8373" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#8D8373" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#FEF4E3" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#0C0B0D" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#1B191C" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#B1AAA0" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#78131F" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#8D8373" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#8D8373" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#FEF4E3" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#FEF4E3" />
</ResourceDictionary>
