<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#F4E6B5" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#302724" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#302724" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#302724" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#FFF5D6" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#302724" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#A48D62" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#FFFAE8" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#302724" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#302724" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#68513D" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#97142B" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#97142B" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#97142B" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#97142B" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#F2DFB8" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#EED2B1" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#302724" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#68513D" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#F4E6B5" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#302724" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#FFF5D6" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#302724" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#A48D62" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#FFFAE8" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#302724" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#302724" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#68513D" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#97142B" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#97142B" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#97142B" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#97142B" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#F2DFB8" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#EED2B1" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#302724" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#68513D" />
</ResourceDictionary>
