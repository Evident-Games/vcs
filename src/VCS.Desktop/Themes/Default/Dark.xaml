<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#100D0E" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#F3EDF0" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#F3EDF0" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#F3EDF0" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#1D1417" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#F3EDF0" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#75414B" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#251B1F" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#F3EDF0" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#F3EDF0" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#C3B1B8" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#F16B7D" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#F16B7D" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#F16B7D" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#F16B7D" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#302026" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#43242D" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#F3EDF0" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#C3B1B8" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#100D0E" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#F3EDF0" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#1D1417" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#F3EDF0" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#75414B" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#251B1F" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#F3EDF0" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#F3EDF0" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#C3B1B8" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#F16B7D" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#F16B7D" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#F16B7D" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#F16B7D" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#302026" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#43242D" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#F3EDF0" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#C3B1B8" />
</ResourceDictionary>
