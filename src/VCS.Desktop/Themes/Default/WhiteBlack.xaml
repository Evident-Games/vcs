<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#F5F5F5" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#111111" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#111111" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#111111" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#111111" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#858585" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#111111" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#111111" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#505050" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#141414" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#141414" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#141414" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#141414" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#EEEEEE" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#DEDEDE" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#111111" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#505050" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#F5F5F5" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#111111" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#111111" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#858585" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#111111" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#111111" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#505050" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#141414" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#141414" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#141414" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#141414" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#EEEEEE" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#DEDEDE" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#111111" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#505050" />
</ResourceDictionary>
