<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="VcsBackground" Color="#F5F5F5" />
    <SolidColorBrush x:Key="VcsCard" Color="#FFFFFF" />
    <!-- Texto de dentro: cartoes, campos, listas e menus abertos. -->
    <SolidColorBrush x:Key="VcsText" Color="#111111" />
    <!-- Texto de fora: direto sobre o fundo da janela (titulo, menu principal, cabecalho e status). -->
    <SolidColorBrush x:Key="VcsOuterText" Color="#111111" />
    <SolidColorBrush x:Key="VcsMuted" Color="#505050" />
    <SolidColorBrush x:Key="VcsBorder" Color="#858585" />
    <SolidColorBrush x:Key="VcsAccent" Color="#141414" />
    <SolidColorBrush x:Key="VcsInput" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsHover" Color="#EEEEEE" />
    <SolidColorBrush x:Key="VcsSelection" Color="#DEDEDE" />
</ResourceDictionary>
