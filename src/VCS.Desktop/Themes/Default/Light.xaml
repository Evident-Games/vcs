<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#FFF9F7" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#252126" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#252126" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#252126" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#252126" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#B6A5AB" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#252126" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#252126" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#655A60" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#A7132B" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#A7132B" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#A7132B" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#A7132B" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#F6ECEE" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#F1DCE1" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#252126" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#655A60" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#FFF9F7" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#252126" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#252126" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#B6A5AB" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#252126" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#252126" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#655A60" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#A7132B" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#A7132B" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#A7132B" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#A7132B" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#F6ECEE" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#F1DCE1" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#252126" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#655A60" />
</ResourceDictionary>
