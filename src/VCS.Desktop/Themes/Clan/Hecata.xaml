<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="VcsBackground" Color="#424C55" />
    <SolidColorBrush x:Key="VcsCard" Color="#3D2C2E" />
    <!-- Texto de dentro: cartoes, campos, listas e menus abertos. -->
    <SolidColorBrush x:Key="VcsText" Color="#F5EDF0" />
    <!-- Texto de fora: direto sobre o fundo da janela (titulo, menu principal, cabecalho e status). -->
    <SolidColorBrush x:Key="VcsOuterText" Color="#D1CCDC" />
    <SolidColorBrush x:Key="VcsMuted" Color="#D1CCDC" />
    <SolidColorBrush x:Key="VcsBorder" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsAccent" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsInput" Color="#424C55" />
    <SolidColorBrush x:Key="VcsHover" Color="#D1CCDC" />
    <SolidColorBrush x:Key="VcsSelection" Color="#424C55" />
    <SolidColorBrush x:Key="VcsHeaderText" Color="#D1CCDC" />
    <SolidColorBrush x:Key="VcsFooterText" Color="#D1CCDC" />
    <SolidColorBrush x:Key="VcsCardText" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsSelectionText" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsInputText" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsInputTitle" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsInputDescription" Color="#D1CCDC" />
    <SolidColorBrush x:Key="VcsAccentText" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsAccentHotbar" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsAccentBorder" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsScroll" Color="#D1CCDC" />
</ResourceDictionary>