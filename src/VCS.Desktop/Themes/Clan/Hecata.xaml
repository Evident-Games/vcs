<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#424C55" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#D1CCDC" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#D1CCDC" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#D1CCDC" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#3D2C2E" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#424C55" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#D1CCDC" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#D1CCDC" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#424C55" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#D1CCDC" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#424C55" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#D1CCDC" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#3D2C2E" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#424C55" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#D1CCDC" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#D1CCDC" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#424C55" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#F5EDF0" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#D1CCDC" />
</ResourceDictionary>
