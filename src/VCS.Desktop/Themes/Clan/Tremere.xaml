<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#3A1642" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#CCB2DC" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#CCB2DC" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#CCB2DC" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#201D1D" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#CCB2DC" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#941414" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#3A1642" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#CCB2DC" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#CCB2DC" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#CCB2DC" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#941414" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#CCB2DC" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#941414" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#937EA5" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#9E7EA5" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#3A1642" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#CCB2DC" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#941414" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#3A1642" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#CCB2DC" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#191919" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#CCB2DC" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#941414" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#3A1642" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#CCB2DC" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#CCB2DC" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#CCB2DC" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#941414" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#CCB2DC" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#941414" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#937EA5" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#9E7EA5" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#3A1642" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#CCB2DC" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#941414" />
</ResourceDictionary>
