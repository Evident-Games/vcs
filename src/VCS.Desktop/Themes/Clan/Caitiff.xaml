<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#16191C" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#0A0B0F" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#64717F" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#16191C" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#64717F" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#64717F" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#64717F" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#64717F" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#16191C" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#0A0B0F" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#64717F" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#16191C" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#64717F" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#64717F" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#64717F" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#64717F" />
</ResourceDictionary>
