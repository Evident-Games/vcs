<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#FF7214" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#333333" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#333333" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#333333" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#FFB53D" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#333333" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#C30011" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#333333" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#333333" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#333333" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#DB0013" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#333333" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#DB0013" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#DB0013" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#333333" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#FF7214" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#FF7214" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#333333" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#FFB53D" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#333333" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#C30011" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#333333" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#333333" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#333333" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#DB0013" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#333333" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#DB0013" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#DB0013" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#333333" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#FF7214" />
</ResourceDictionary>
