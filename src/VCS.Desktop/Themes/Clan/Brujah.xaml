<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="VcsBackground" Color="#FF7214" />
    <SolidColorBrush x:Key="VcsCard" Color="#FFB53D" />
    <!-- Texto de dentro: cartoes, campos, listas e menus abertos. -->
    <SolidColorBrush x:Key="VcsText" Color="#FFFFFF" />
    <!-- Texto de fora: direto sobre o fundo da janela (titulo, menu principal, cabecalho e status). -->
    <SolidColorBrush x:Key="VcsOuterText" Color="#333333" />
    <SolidColorBrush x:Key="VcsMuted" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsBorder" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsAccent" Color="#DB0013" />
    <SolidColorBrush x:Key="VcsInput" Color="#333333" />
    <SolidColorBrush x:Key="VcsHover" Color="#DB0013" />
    <SolidColorBrush x:Key="VcsSelection" Color="#333333" />
    <SolidColorBrush x:Key="VcsHeaderText" Color="#333333" />
    <SolidColorBrush x:Key="VcsFooterText" Color="#333333" />
    <SolidColorBrush x:Key="VcsCardText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsSelectionText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsInputText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsInputTitle" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsInputDescription" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsAccentText" Color="#DB0013" />
    <SolidColorBrush x:Key="VcsAccentHotbar" Color="#DB0013" />
    <SolidColorBrush x:Key="VcsAccentBorder" Color="#DB0013" />
    <SolidColorBrush x:Key="VcsScroll" Color="#FFFFFF" />
</ResourceDictionary>