<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#96A1CA" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#E1FBFE" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#E1FBFE" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#F0EEF1" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#F0EEF1" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#B7B1CF" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#96A1CA" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#000000" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#B7B1CF" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#96A1CA" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#F0EEF1" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#F0EEF1" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#DB3456" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#B7B1CF" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#F0EEF1" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#000000" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#B7B1CF" />
</ResourceDictionary>
