<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#72171A" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#23101B" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#FBF7F4" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#424242" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#FBF7F4" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#FBF7F4" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#72171A" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#72171A" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#FBF7F4" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#B29D34" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#72171A" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#23101B" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#FBF7F4" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#424242" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#FBF7F4" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#FBF7F4" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#72171A" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#72171A" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#FBF7F4" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#B29D34" />
</ResourceDictionary>
