<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="VcsBackground" Color="#72171A" />
    <SolidColorBrush x:Key="VcsCard" Color="#23101B" />
    <!-- Texto de dentro: cartoes, campos, listas e menus abertos. -->
    <SolidColorBrush x:Key="VcsText" Color="#FBF7F4" />
    <!-- Texto de fora: direto sobre o fundo da janela (titulo, menu principal, cabecalho e status). -->
    <SolidColorBrush x:Key="VcsOuterText" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsMuted" Color="#FBF7F4" />
    <SolidColorBrush x:Key="VcsBorder" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsAccent" Color="#B29D34" />
    <SolidColorBrush x:Key="VcsInput" Color="#424242" />
    <SolidColorBrush x:Key="VcsHover" Color="#72171A" />
    <SolidColorBrush x:Key="VcsSelection" Color="#B29D34" />
</ResourceDictionary>