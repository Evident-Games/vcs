<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#4A001F" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#DD2C68" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#DD2C68" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#DD2C68" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#4A001F" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#DD2C68" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#F3AFB6" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#4A001F" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#DD2C68" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#DD2C68" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#DD2C68" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#DD2C68" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#DD2C68" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#F3AFB6" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#F3AFB6" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#F3AFB6" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#F3AFB6" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#000000" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#F3AFB6" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#4A001F" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#DD2C68" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#4A001F" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#DD2C68" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#F3AFB6" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#4A001F" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#DD2C68" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#DD2C68" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#DD2C68" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#DD2C68" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#DD2C68" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#F3AFB6" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#F3AFB6" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#F3AFB6" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#F3AFB6" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#000000" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#F3AFB6" />
</ResourceDictionary>
