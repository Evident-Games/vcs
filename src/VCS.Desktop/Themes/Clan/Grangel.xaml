<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#2E2F04" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#442604" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#D4A325" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#333333" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#D4A325" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#D4A325" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#D4A325" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#D4A325" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#D4A325" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#D4A325" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#2E2F04" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#D4A325" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#2E2F04" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#442604" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#D4A325" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#333333" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#D4A325" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#D4A325" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#D4A325" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#D4A325" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#D4A325" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#D4A325" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#2E2F04" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#D4A325" />
</ResourceDictionary>
