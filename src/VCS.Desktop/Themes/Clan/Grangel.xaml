<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="VcsBackground" Color="#2E2F04" />
    <SolidColorBrush x:Key="VcsCard" Color="#442604" />
    <!-- Texto de dentro: cartoes, campos, listas e menus abertos. -->
    <SolidColorBrush x:Key="VcsText" Color="#FFFFFF" />
    <!-- Texto de fora: direto sobre o fundo da janela (titulo, menu principal, cabecalho e status). -->
    <SolidColorBrush x:Key="VcsOuterText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsMuted" Color="#7E846B" />
    <SolidColorBrush x:Key="VcsBorder" Color="#B48A1F" />
    <SolidColorBrush x:Key="VcsAccent" Color="#B48A1F" />
    <SolidColorBrush x:Key="VcsInput" Color="#442604" />
    <SolidColorBrush x:Key="VcsHover" Color="#B48A1F" />
    <SolidColorBrush x:Key="VcsSelection" Color="#B48A1F" />
</ResourceDictionary>