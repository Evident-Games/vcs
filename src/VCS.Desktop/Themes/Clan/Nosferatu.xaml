<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#363D38" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#DAD79D" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#DAD79D" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#DAD79D" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#272826" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#DAD79D" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#4D2B1E" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#363D38" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#DAD79D" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#DAD79D" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#DAD79D" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#DAD79D" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#DAD79D" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#4D2B1E" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#4D2B1E" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#272826" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#404E51" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#DAD79D" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#4D2B1E" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#363D38" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#DAD79D" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#272826" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#DAD79D" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#4D2B1E" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#363D38" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#DAD79D" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#DAD79D" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#DAD79D" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#DAD79D" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#DAD79D" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#4D2B1E" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#4D2B1E" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#272826" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#404E51" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#DAD79D" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#4D2B1E" />
</ResourceDictionary>
