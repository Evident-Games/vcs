<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#380C00" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#150200" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#DD4132" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#150200" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#DD4132" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#581300" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#581300" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#FFE3D0" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#380C00" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#150200" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#DD4132" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#150200" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#DD4132" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#581300" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#581300" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#FFE3D0" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#FFE3D0" />
</ResourceDictionary>
