<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#222862" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#F5F2EF" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#F5F2EF" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#F5F2EF" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#F5F2EF" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#0F0D4F" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#B09E4F" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#F5F2EF" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#0F0D4F" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#0F0D4F" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#0F0D4F" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#0F0D4F" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#0F0D4F" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#B09E4F" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#B09E4F" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#B09E4F" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#B09E4F" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#0F0D4F" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#B09E4F" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#222862" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#F5F2EF" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#F5F2EF" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#0F0D4F" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#B09E4F" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#F5F2EF" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#0F0D4F" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#0F0D4F" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#0F0D4F" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#0F0D4F" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#0F0D4F" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#B09E4F" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#B09E4F" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#B09E4F" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#B09E4F" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#0F0D4F" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#B09E4F" />
</ResourceDictionary>
