<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#552961" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#333333" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#86A59C" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#552961" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#86A59C" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#5A4D2B" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#86A59C" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#545454" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <!-- COPIAR DE CIMA ABAIXO -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#552961" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#333333" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#86A59C" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#552961" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#86A59C" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#5A4D2B" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#86A59C" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#CCDAD0" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#545454" />
</ResourceDictionary>
