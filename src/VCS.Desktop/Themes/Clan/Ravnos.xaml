<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#953939" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#FFA82C" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#FFA82C" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#FFA82C" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#5C251F" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#FFA82C" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#FFA82C" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#5C251F" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#FFA82C" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#FFA82C" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#FFA82C" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#FFA82C" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#FFA82C" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#C78F44" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#C78F44" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#953939" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#953939" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#C78F44" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#953939" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#FFA82C" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#5C251F" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#FFA82C" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#FFA82C" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#5C251F" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#FFA82C" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#FFA82C" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#FFA82C" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#FFA82C" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#FFA82C" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#C78F44" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#C78F44" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#953939" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#953939" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#C78F44" />
</ResourceDictionary>
