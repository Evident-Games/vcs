<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#445E93" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#FFD806" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#FCB0B3" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#FCB0B3" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#48649C" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#FFD806" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#FCB0B3" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#445E93" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#FFD806" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#FFD806" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#FFD806" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#FFD806" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#FFD806" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#FCB0B3" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#FCB0B3" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#CE2F37" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#CE2F37" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#FFD806" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#CE2F37" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#445E93" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#FFD806" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#48649C" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#FFD806" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#FCB0B3" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#445E93" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#FFD806" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#FFD806" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#FFD806" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#FFD806" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#FFD806" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#FCB0B3" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#FCB0B3" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#CE2F37" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#CE2F37" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#FFD806" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#CE2F37" />
</ResourceDictionary>
