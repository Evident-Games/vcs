<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="VcsBackground" Color="#0C0C0C" />
    <SolidColorBrush x:Key="VcsCard" Color="#191919" />
    <!-- Texto de dentro: cartoes, campos, listas e menus abertos. -->
    <SolidColorBrush x:Key="VcsText" Color="#FAFAFA" />
    <!-- Texto de fora: direto sobre o fundo da janela (titulo, menu principal, cabecalho e status). -->
    <SolidColorBrush x:Key="VcsOuterText" Color="#FAFAFA" />
    <SolidColorBrush x:Key="VcsMuted" Color="#D8D8D8" />
    <SolidColorBrush x:Key="VcsBorder" Color="#AAAAAA" />
    <SolidColorBrush x:Key="VcsAccent" Color="#F2F2F2" />
    <SolidColorBrush x:Key="VcsInput" Color="#000000" />
    <SolidColorBrush x:Key="VcsHover" Color="#0C0C0C" />
    <SolidColorBrush x:Key="VcsSelection" Color="#151515"/>
</ResourceDictionary>