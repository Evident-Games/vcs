<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="VcsBackground" Color="#1C1A27" />
    <SolidColorBrush x:Key="VcsCard" Color="#0D080C" />
    <!-- Texto de dentro: cartoes, campos, listas e menus abertos. -->
    <SolidColorBrush x:Key="VcsText" Color="#BAC4FF" />
    <!-- Texto de fora: direto sobre o fundo da janela (titulo, menu principal, cabecalho e status). -->
    <SolidColorBrush x:Key="VcsOuterText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsMuted" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsBorder" Color="#292B36" />
    <SolidColorBrush x:Key="VcsAccent" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsInput" Color="#201A28" />
    <SolidColorBrush x:Key="VcsHover" Color="#19272A" />
    <SolidColorBrush x:Key="VcsSelection" Color="#19272A" />
    <SolidColorBrush x:Key="VcsHeaderText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsFooterText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsCardText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsSelectionText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsInputText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsInputTitle" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsInputDescription" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsAccentText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsAccentHotbar" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsAccentBorder" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsScroll" Color="#BAC4FF" />
</ResourceDictionary>