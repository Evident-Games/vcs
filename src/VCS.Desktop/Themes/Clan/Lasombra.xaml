<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#1C1A27" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#0D080C" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#292B36" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#201A28" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#19272A" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#19272A" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#BAC4FF" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#1C1A27" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#0D080C" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#292B36" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#201A28" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#19272A" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#19272A" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#BAC4FF" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#BAC4FF" />
</ResourceDictionary>
