<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Aplicacao: janela, titulo, menu principal, lista lateral, abas de fichas e status. -->
    <SolidColorBrush x:Key="VcsAppBackground" Color="#1C0118" />
    <SolidColorBrush x:Key="VcsAppOuterText" Color="#8BD425" />
    <SolidColorBrush x:Key="VcsAppHeaderText" Color="#8BD425" />
    <SolidColorBrush x:Key="VcsAppFooterText" Color="#8BD425" />
    <SolidColorBrush x:Key="VcsAppCard" Color="#370928" />
    <SolidColorBrush x:Key="VcsAppCardText" Color="#8BD425" />
    <SolidColorBrush x:Key="VcsAppBorder" Color="#618B25" />
    <SolidColorBrush x:Key="VcsAppInput" Color="#1C0118" />
    <SolidColorBrush x:Key="VcsAppInputText" Color="#8BD425" />
    <SolidColorBrush x:Key="VcsAppInputTitle" Color="#8BD425" />
    <SolidColorBrush x:Key="VcsAppInputDescription" Color="#6BD425" />
    <SolidColorBrush x:Key="VcsAppAccent" Color="#68D425" />
    <SolidColorBrush x:Key="VcsAppAccentText" Color="#68D425" />
    <SolidColorBrush x:Key="VcsAppAccentBorder" Color="#618B25" />
    <SolidColorBrush x:Key="VcsAppAccentHotbar" Color="#61452E" />
    <SolidColorBrush x:Key="VcsAppHover" Color="#61452E" />
    <SolidColorBrush x:Key="VcsAppSelection" Color="#61452E" />
    <SolidColorBrush x:Key="VcsAppSelectionText" Color="#6BD425" />
    <SolidColorBrush x:Key="VcsAppScroll" Color="#618B25" />

    <!-- Ficha: tudo dentro da ficha aberta. Pode vir de outro tema que o da aplicacao. -->
    <SolidColorBrush x:Key="VcsSheetBackground" Color="#1C0118" />
    <SolidColorBrush x:Key="VcsSheetOuterText" Color="#8BD425" />
    <SolidColorBrush x:Key="VcsSheetCard" Color="#370928" />
    <SolidColorBrush x:Key="VcsSheetCardText" Color="#8BD425" />
    <SolidColorBrush x:Key="VcsSheetBorder" Color="#818B25" />
    <SolidColorBrush x:Key="VcsSheetInput" Color="#1C0118" />
    <SolidColorBrush x:Key="VcsSheetInputText" Color="#8BD425" />
    <SolidColorBrush x:Key="VcsSheetInputTitle" Color="#8BD425" />
    <SolidColorBrush x:Key="VcsSheetInputDescription" Color="#6BD425" />
    <SolidColorBrush x:Key="VcsSheetAccent" Color="#68D425" />
    <SolidColorBrush x:Key="VcsSheetAccentText" Color="#68D425" />
    <SolidColorBrush x:Key="VcsSheetAccentBorder" Color="#818B25" />
    <SolidColorBrush x:Key="VcsSheetAccentHotbar" Color="#61452E" />
    <SolidColorBrush x:Key="VcsSheetHover" Color="#61452E" />
    <SolidColorBrush x:Key="VcsSheetSelection" Color="#61452E" />
    <SolidColorBrush x:Key="VcsSheetSelectionText" Color="#6BD425" />
    <SolidColorBrush x:Key="VcsSheetScroll" Color="#618B25" />
</ResourceDictionary>
