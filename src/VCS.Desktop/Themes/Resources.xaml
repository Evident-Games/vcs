<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:themes="clr-namespace:VCS.Desktop.Themes">
    <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="/VCS.Desktop;component/Themes/ScrollControls.xaml" />
        <ResourceDictionary Source="/VCS.Desktop;component/Themes/ChromeControls.xaml" />
        <ResourceDictionary Source="/VCS.Desktop;component/Themes/InputControls.xaml" />
        <ResourceDictionary Source="/VCS.Desktop;component/Themes/ListControls.xaml" />
        <ResourceDictionary Source="/VCS.Desktop;component/Themes/ButtonControls.xaml" />
        <themes:ThemePalette />
    </ResourceDictionary.MergedDictionaries>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <DataTemplate x:Key="SheetExtraField">
        <StackPanel Margin="8">
            <TextBlock Text="{Binding Label}" Style="{DynamicResource FieldLabel}" />
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" MaxLength="{Binding MaximumLength}"
                     AcceptsReturn="{Binding Multiline}" TextWrapping="Wrap" MinHeight="{Binding FieldHeight}"
                     MaxHeight="240" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{Binding Label}" />
        </StackPanel>
    </DataTemplate>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource VcsInputDescription}" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource VcsInputTitle}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource VcsCard}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource VcsCardText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource VcsBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <!-- Discreet underlined "predador" mark beside a discipline or skill; bold accent once it holds the free bonus. -->
    <Style x:Key="PredatorTag" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource VcsInputDescription}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Content" Value="✧" />
        <Setter Property="ToolTip" Value="{Binding PredatorTagTip}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
        <Setter Property="CommandParameter" Value="{Binding}" />
        <Setter Property="Visibility" Value="{Binding IsPredatorChoice, Converter={StaticResource BoolVisibility}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock Text="{TemplateBinding Content}" Background="Transparent" Padding="2,0"
                               Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                               FontWeight="{TemplateBinding FontWeight}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource VcsCardText}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsPredatorPending}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource VcsAccentText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasPredatorBonus}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource VcsAccentText}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Content" Value="✦" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
